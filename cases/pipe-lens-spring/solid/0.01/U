FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0.01";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    interface_upstream
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    interface_downstream
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    rim
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    axisApprox
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    symmetry_z
    {
        type            symmetryPlane;
    }
    symmetry_y
    {
        type            symmetryPlane;
    }
}


