#!/bin/bash
# doc-g2-sim1 — Allclean

set -e
cd "$(dirname "$0")"

echo "=== doc-g2-sim1: cleaning fluid domain ==="

(
    cd fluid
    rm -rf log.* postProcessing
    for d in ./[0-9]*; do
        [ -e "$d" ] || continue
        base=$(basename "$d")
        case "$base" in
            0) ;;
            *) rm -rf "$d" ;;
        esac
    done
    rm -rf constant/polyMesh
    rm -f eye_g2_fluid_lamminsalo.msh
    mkdir -p 0
    cp -f initial/U 0/U
    cp -f initial/p 0/p
    touch doc-g2-sim1-fluid.foam
    echo "  fluid cleaned"
)

echo "=== doc-g2-sim1: clean done ==="
