FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// doc-g2-sim1: steady simpleFoam — G2-fluid 90° calotte (AC / vitreous / TM)

application     simpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2000;

deltaT          1;

writeControl    timeStep;
writeInterval   50;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    flowRateTM
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        fields          (phi);
        operation       sum;
        regionType      patch;
        name            outlet_tm;
        writeFields     false;
        log             true;
        writeControl    timeStep;
        writeInterval   10;
    }

    pressureACinlet
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        fields          (p);
        operation       areaAverage;
        regionType      patch;
        name            ac_inlet;
        writeFields     false;
        log             true;
        writeControl    timeStep;
        writeInterval   10;
    }

    iop_probe
    {
        type            probes;
        libs            (sampling);
        fields          (p);
        // AC anterior pocket; vitreous posterior (sector x≥0, z≤0)
        probeLocations
        (
            ( 0.0015   -0.0068   0.0000)   // AC on z=0
            ( 0.00106  -0.0068  -0.00106)  // AC mid-sector
            ( 0.0020    0.0030   0.0000)   // vitreous on z=0
            ( 0.00141   0.0030  -0.00141)  // vitreous mid-sector
        );
        writeControl    timeStep;
        writeInterval   10;
    }
}
