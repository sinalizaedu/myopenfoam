    (0          -5.38        3.11      )     // 63  O
    (0          -5.27        3.00      )     // 64  P
    (0          -4.36082941  5.21718   )     // 65  Y
    (0          -5.2270723   3.00      )     // 66  R
    (0          -7.5315989   3.11      )     // 67  T
    (0          -7.2119900   3.78      )     // 68  U
    (0           6.56228999  2.58647221)     // 69  S1
    (0           5.58221723  4.91976254)     // 70  S2
    (0           4.05571823  6.77147221)     // 71  S3
    (0           2.13221723  7.96034307)     // 72  S4
    (0           0.0         8.37      )     // 73  S5
    (0          -2.00        8.01      )     // 74  I
    (0           0.53770000  0.98466162)     // 75  W1
    (0           0.23517400  1.92726600)     // 76  W2
    (0          -0.25466200  2.78754500)     // 77  W3
    (0          -0.91087800  3.52877400)     // 78  W4
    (0          -1.70545300  4.11925900)     // 79  W5
