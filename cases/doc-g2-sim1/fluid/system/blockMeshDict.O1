    // ---------------- on the revolve axis (shared by all layers) --------
    (0          -8.16        0)              // 81  A   cornea apex
    (0           6.90        0)              // 82  J   posterior pole
    (0           0.64        0)              // 83  K   lens rear apex
    (0          -6.07        0)              // 84  M   lens front apex
    (0          -7.00        0)              // 85  V   ACP needle site
    (0          -7.60        0)              // 86  V2

    // ---------------- Z, appended (bisector cut on iris F-N) ------------
    (6.07547500 -4.26313     0          )    // 87  Z   theta = 0
    (4.29600956 -4.26313     4.29600956 )    // 88  Z   theta = 45
    (0          -4.26313     6.07547500 )    // 89  Z   theta = 90
