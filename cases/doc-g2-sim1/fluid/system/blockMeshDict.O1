// ---------------------------------------------------------------------------
// Blocks.  16 meridional regions x 2 theta blocks = 32.
//
// Division chains forced by face matching (do not break these):
//   TM.x2  = ANG.x1                   = 12
//   ANG.x2 = AC1.x1 = AC2.x1 = AC3.x2 = 12
//   AC1.x2                            = 22
//   AC3.x1 = AC4.x1 = AC5.x1          = 32
//   AC5.x2 = PCi.x1 = PCo.x1          =  8   (cells across the pupil gap)
//   PCo.x2 = VIT1..VIT7.x2            = 28   (same grading required)
//   n_theta                           =  6   per 45 deg block (12 over 90)
// ---------------------------------------------------------------------------

blocks
(
    // ============================ TM ==================================
    // Table SI parallelogram: 0.34713 mm (C-D outlet face) x 0.11402 mm
    // (B-C, the flow direction), corner angle 86.4 deg, area 0.0395 mm^2.
    // x1 = B->C across the meshwork (5 cells, 22.8 um)
    // x2 = B->E along it           (12 cells, 28.9 um)
    hex (0 1 2 3 27 28 29 30)        tm_zone (5 12 6) simpleGrading (1 1 1)
    hex (27 28 29 30 54 55 56 57)    tm_zone (5 12 6) simpleGrading (1 1 1)

    // ============ ANG : iridocorneal angle recess, B-E-F-Z ============
    // Convex quad, interior angles 93.55 (B) / 147.04 (E) / 65.05 (F) /
    // 54.36 (Z) deg.  Carries the TM interface B-E and the ciliary face E-F.
    hex (0 3 4 87 27 30 31 88)               (12 12 6) simpleGrading (1 1 1)
    hex (27 30 31 88 54 57 58 89)            (12 12 6) simpleGrading (1 1 1)

    // ============ AC1 : peripheral AC, B-Z-N-U ========================
    // Interior angles 93.55 (B) / 125.64 (Z) / 106.42 (N) / 61.84 (U) deg.
    // x1 tapers 0.678 mm (cut B-Z) to 2.272 mm (cut N-U), which refines the
    // mesh into the outflow corner for free.
    hex (0 87 8 14 27 88 35 41)              (12 22 6) simpleGrading (1 1 1)
    hex (27 88 35 41 54 89 62 68)            (12 22 6) simpleGrading (1 1 1)

    // ===================== AC2 : mid AC ===============================
    hex (14 8 9 13 41 35 36 40)              (12 6 6) simpleGrading (1 1 1)
    hex (41 35 36 40 68 62 63 67)            (12 6 6) simpleGrading (1 1 1)

    // ===================== AC3 : central AC, on axis ==================
    hex (81 13 9 86 81 40 36 86)             (32 12 6) simpleGrading (1 1 1)
    hex (81 40 36 86 81 67 63 86)            (32 12 6) simpleGrading (1 1 1)

    // ===================== AC4 : around the iris tip, on axis =========
    // x2 runs O->P at the iris tip and V2->V on the axis, and both of its
    // x1-faces are free (axis and iris wall), so it can be graded without
    // touching any neighbour.  Ratio 0.5 shrinks the axis cells from 0.128 to
    // 0.064 mm toward V = (0, -7.00), the ACP needle site, which also halves
    // the jump onto AC3's 0.047 mm cells on the other side of V2.
    hex (86 9 10 85 86 36 37 85)             (32 6 6) simpleGrading (1 0.5 1)
    hex (86 36 37 85 86 63 64 85)            (32 6 6) simpleGrading (1 0.5 1)

    // ===================== AC5 : pupil exit, on axis ==================
    // x2 spans 0.93 mm on the axis down to 0.0429 mm at the throat P-R.
    hex (85 10 12 84 85 37 39 84)            (32 8 6) simpleGrading (1 1 1)
    hex (85 37 39 84 85 64 66 84)            (32 8 6) simpleGrading (1 1 1)

    // ============ PCi : pupil channel, throat R-P to cut L-Y ==========
    // x1 crosses the iris-lens gap everywhere: 8 cells over 0.9185 mm at
    // the L-Y cut down to 8 cells over 37.3 um at the minimum section.
    // The two x2 edges (lens arc R-L 2.4295 mm, iris P-Q-Y 2.4226 mm) are
    // within 0.3% of each other, so the grid lines stay near-orthogonal.
    hex (12 10 11 7 39 37 38 34)             (8 20 6) simpleGrading (1 1 1)
    hex (39 37 38 34 66 64 65 61)            (8 20 6) simpleGrading (1 1 1)

    // ============ PCo : posterior chamber, cut L-Y to inlet H-G =======
    // x2 grading must match VIT (shared face L-H).
    hex (7 11 5 6 34 38 32 33)               (8 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
    hex (34 38 32 33 61 65 59 60)            (8 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)

    // ===================== VIT1..VIT7 : vitreous ======================
    // Named vitreous_zone so porosity covers the whole vitreous (lens rear
    // → retina), not the truncated y>=-1.5 mm box formerly used by topoSet.
    // x1 = meridional (axis -> equatorial chord), x2 = radial (lens rear
    // surface -> retina shell).  The x2 multi-grading puts 12 of the 28
    // cells into y = 2.39..3.90 mm on the axis, i.e. 0.125 mm cells around
    // the IVI needle site at (0, +3.0, 0).
    hex (83 21 15 82 83 48 42 82)    vitreous_zone (17 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
    hex (83 48 42 82 83 75 69 82)    vitreous_zone (17 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)

    hex (21 22 16 15 48 49 43 42)    vitreous_zone (16 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
    hex (48 49 43 42 75 76 70 69)    vitreous_zone (16 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)

    hex (22 23 17 16 49 50 44 43)    vitreous_zone (15 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
    hex (49 50 44 43 76 77 71 70)    vitreous_zone (15 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)

    hex (23 24 18 17 50 51 45 44)    vitreous_zone (14 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
    hex (50 51 45 44 77 78 72 71)    vitreous_zone (14 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)

    hex (24 25 19 18 51 52 46 45)    vitreous_zone (14 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
    hex (51 52 46 45 78 79 73 72)    vitreous_zone (14 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)

    hex (25 26 20 19 52 53 47 46)    vitreous_zone (13 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
    hex (52 53 47 46 79 80 74 73)    vitreous_zone (13 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)

    hex (26 7 6 20 53 34 33 47)      vitreous_zone (11 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
    hex (53 34 33 47 80 61 60 74)    vitreous_zone (11 28 6)
        simpleGrading (1 ((0.28 0.2857 1) (0.24 0.4286 1) (0.48 0.2857 1)) 1)
);


// ---------------------------------------------------------------------------
// Edges.  Circular arcs use "origin" so no interpolation points are needed;
// only the six vitreous_retina ellipse segments carry explicit mid-t points.
// ---------------------------------------------------------------------------

edges
(
    // ============ circumferential arcs, one per off-axis vertex ========
    arc  0 27 origin (0 -4.68       0)   arc 27 54 origin (0 -4.68       0) // B
    arc  1 28 origin (0 -4.75       0)   arc 28 55 origin (0 -4.75       0) // C
    arc  2 29 origin (0 -4.49       0)   arc 29 56 origin (0 -4.49       0) // D
    arc  3 30 origin (0 -4.42       0)   arc 30 57 origin (0 -4.42       0) // E
    arc  4 31 origin (0 -4.02       0)   arc 31 58 origin (0 -4.02       0) // F
    arc  5 32 origin (0 -3.86       0)   arc 32 59 origin (0 -3.86       0) // G
    arc  6 33 origin (0 -3.35       0)   arc 33 60 origin (0 -3.35       0) // H
    arc  7 34 origin (0 -3.57       0)   arc 34 61 origin (0 -3.57       0) // L
    arc  8 35 origin (0 -4.94       0)   arc 35 62 origin (0 -4.94       0) // N
    arc  9 36 origin (0 -5.38       0)   arc 36 63 origin (0 -5.38       0) // O
    arc 10 37 origin (0 -5.27       0)   arc 37 64 origin (0 -5.27       0) // P
    arc 11 38 origin (0 -4.36082941 0)   arc 38 65 origin (0 -4.36082941 0) // Y
    arc 12 39 origin (0 -5.2270723  0)   arc 39 66 origin (0 -5.2270723  0) // R
    arc 13 40 origin (0 -7.5315989  0)   arc 40 67 origin (0 -7.5315989  0) // T
    arc 14 41 origin (0 -7.2119900  0)   arc 41 68 origin (0 -7.2119900  0) // U
    arc 15 42 origin (0  6.56228999 0)   arc 42 69 origin (0  6.56228999 0) // S1
    arc 16 43 origin (0  5.58221723 0)   arc 43 70 origin (0  5.58221723 0) // S2
    arc 17 44 origin (0  4.05571823 0)   arc 44 71 origin (0  4.05571823 0) // S3
    arc 18 45 origin (0  2.13221723 0)   arc 45 72 origin (0  2.13221723 0) // S4
    arc 19 46 origin (0  0.0        0)   arc 46 73 origin (0  0.0        0) // S5
