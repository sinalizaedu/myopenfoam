FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}

// on-caso-2 - FLAMBAGEM com BCs do on-mestrado-2 portadas para o tubo
// 4-zonas. SEM FSI (solido puro). Solver NL geometry para capturar K_sigma.
//
// BCs:
//   z=0 (canal optico, ENGASTE):
//     posterior_{on,pia,dura}  = fixedDisplacement (0 0 0)
//       Ancoragem rigida ao osso do canal optico via adesoes fibrosas de
//       colageno (on, pia) e fusao dura<->periosteo (Sigal/Wang).
//     posterior_sas             = solidTraction P_CSF=1333 Pa (~10 mmHg)
//       Coluna do LCR vinda do cerebro empurra axialmente a tampa anterior.
//       Mesmo valor do on-mestrado-2 (PIC normal supino).
//
//   z=30 (TAMPA anterior - cinematica imposta nas 4 zonas):
//     anterior_{on,pia,sas,dura} = fixedDisplacement via displacementSeries
//       Rampa de Dz=0 -> -1 mm em 40 passos (constant/timeVsDisp).
//       anterior_sas vai junto com as 3 outras para garantir continuidade
//       radial nas arestas r=1.55 e r=2.35 (lesson learned do on-flambagem-2).
//
//   dura_outer (lateral, r=2.5 mm): Winkler 200 kPa/m
//     k = E_fat / t_fat = 500 Pa / 0.0025 m = 200000 Pa/m
//     Gordura orbital realista (Schoemaker 2006, Yoo 2011), IDENTICO ao
//     on-mestrado-2. Bem mais rigida que os 700 Pa/m macios do
//     on-flambagem-2 - aumenta P_cr porem mantem realismo anatomico.
//
//   perturbation_strip (carved-out de dura_outer em z=[12;18] mm, +X):
//     solidTraction com 10 Pa lateral - quebra de simetria para selecionar
//     modo de flambagem. Magnitude ~10^-5 da carga axial de pico, nao
//     altera P_cr (truque validado em on-buckling-tube). Sem isso, o
//     cilindro perfeito sob compressao pura nao tem direcao preferencial
//     de bifurcacao -> solver nao detecta numericamente.

dimensions      [ 0 1 0 0 0 0 0 ];

internalField   uniform (0 0 0);

boundaryField
{
    // ----- z=0 mm: canal optico - ENGASTE TOTAL --------------------------
    posterior_on
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
    }

    posterior_pia
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
    }

    // ----- z=0 mm: SAS aberta - coluna do LCR vinda do cerebro -----------
    //   P_CSF = 1333 Pa (~10 mmHg) - PIC normal supino. Igual on-mestrado-2.
    posterior_sas
    {
        type        solidTraction;
        traction    uniform ( 0 0 0 );
        pressure    uniform 1333;
        value       uniform ( 0 0 0 );
    }

    posterior_dura
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
    }

    // ----- z=30 mm: TAMPA anterior - rampa de Dz imposta nas 4 zonas -----
    //   Cinematica imposta via displacementSeries (constant/timeVsDisp).
    //   Aplicada SIMULTANEAMENTE em on/pia/sas/dura: deixar anterior_sas
    //   solto cria descontinuidade nas arestas r=1.55 e r=2.35 -> NaN
    //   imediato (vide log do on-flambagem-2).
    anterior_on
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
        displacementSeries
        {
            file                "$FOAM_CASE/constant/timeVsDisp";
            outOfBounds         clamp;
            interpolationScheme linear;
        }
    }

    anterior_pia
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
        displacementSeries
        {
            file                "$FOAM_CASE/constant/timeVsDisp";
            outOfBounds         clamp;
            interpolationScheme linear;
        }
    }

    anterior_sas
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
        displacementSeries
        {
            file                "$FOAM_CASE/constant/timeVsDisp";
            outOfBounds         clamp;
            interpolationScheme linear;
        }
    }

    anterior_dura
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
        displacementSeries
        {
            file                "$FOAM_CASE/constant/timeVsDisp";
            outOfBounds         clamp;
            interpolationScheme linear;
        }
    }

    // ----- dura_outer (lateral, r=2.5 mm): Winkler 200 kPa/m ------------
    //   Gordura orbital realista, identico ao on-mestrado-2.
    dura_outer
    {
        type        solidTractionElasticFoundation;
        k           200000;
        traction    uniform ( 0 0 0 );
        pressure    uniform 0;
        value       uniform ( 0 0 0 );
    }

    // ----- perturbation_strip (carved-out de dura_outer): quebra simetria -
    //   Patch criado por topoSet + createPatch em z=[12;18] mm, eixo +X.
    //   solidTraction com 10 Pa de pressao = forca lateral ~ 10^-5 da carga
    //   axial de pico. Magnitude validada em on-buckling-tube; nao altera
    //   P_cr quantitativo, apenas seleciona o modo de flambagem.
    perturbation_strip
    {
        type        solidTraction;
        traction    uniform ( 0 0 0 );
        pressure    uniform 10;
        value       uniform ( 0 0 0 );
    }
}
