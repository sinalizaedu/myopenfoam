FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

pointSync false;

patches
(
    {
        name            iris_wall;
        patchInfo { type wall; }
        constructFrom set;
        set     iris_wall_faces;
    }
    {
        name            lens_wall;
        patchInfo { type wall; }
        constructFrom set;
        set     lens_wall_faces;
    }
);
