FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// After demote: only `wall` holds candidates.

actions
(
    {
        name    wall_pool;
        type    faceSet;
        action  new;
        source  patchToFace;
        patch   wall;
    }

    {
        name    outlet_tm_faces;
        type    faceSet;
        action  new;
        source  faceToFace;
        set     wall_pool;
    }
    {
        name    outlet_tm_faces;
        type    faceSet;
        action  subset;
        source  cylinderAnnulusToFace;
        p1      (0 -0.00478 0);
        p2      (0 -0.00445 0);
        outerRadius 0.00698;
        innerRadius 0.00660;
    }

    {
        name    ac_inlet_faces;
        type    faceSet;
        action  new;
        source  faceToFace;
        set     wall_pool;
    }
    {
        name    ac_inlet_faces;
        type    faceSet;
        action  subset;
        source  cylinderAnnulusToFace;
        p1      (0 -0.00388 0);
        p2      (0 -0.00340 0);
        outerRadius 0.00705;
        innerRadius 0.00685;
    }
    {
        name    ac_inlet_faces;
        type    faceSet;
        action  delete;
        source  faceToFace;
        set     outlet_tm_faces;
    }
);
