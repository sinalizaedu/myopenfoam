FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// doc-g3-sim1: transient pimpleFoam + preCICE (FSI one-way Force)

application     pimpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.01;

deltaT          0.01;

writeControl    timeStep;
writeInterval   10;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    preCICE_Adapter
    {
        type preciceAdapterFunctionObject;
        libs ("libpreciceAdapterFunctionObject.so");
    }

    flowRateTM
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        fields          (phi);
        operation       sum;
        regionType      patch;
        name            outlet_tm;
        writeFields     false;
        log             true;
        writeControl    timeStep;
        writeInterval   10;
    }

    pressureACinlet
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        fields          (p);
        operation       areaAverage;
        regionType      patch;
        name            ac_inlet;
        writeFields     false;
        log             true;
        writeControl    timeStep;
        writeInterval   10;
    }

    iop_probe
    {
        type            probes;
        libs            (sampling);
        fields          (p);
        probeLocations
        (
            ( 0.0015   -0.0068   0.0000)
            ( 0.00106  -0.0068  -0.00106)
            ( 0.0020    0.0030   0.0000)
            ( 0.00141   0.0030  -0.00141)
        );
        writeControl    timeStep;
        writeInterval   10;
    }
}
