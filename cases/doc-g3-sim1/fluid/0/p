FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// P_TM = 10 Torr → p = 10*133.322/995 ≈ 1.3399 m²/s²
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 1.3399;
boundaryField
{
    ac_inlet { type zeroGradient; }
    outlet_tm { type fixedValue; value uniform 1.3399; }
    wall { type zeroGradient; }
    fsi_wall { type zeroGradient; }
    lens_wall { type zeroGradient; }
    iris_wall { type zeroGradient; }
    symmetry_0 { type symmetry; }
    symmetry_90 { type symmetry; }
    defaultFaces { type symmetry; }
}
