FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// on-flam-sfsi-2 - cria face set 'perturbation_strip' no dura_outer para
// servir de imperfeicao lateral (quebra de simetria do cilindro perfeito).
//
// Geometria: r=2.5 mm (raio externo da dura), eixo +X, terco medio axial
// (z=[12;18] mm = 6 mm, ao redor de L/2=15 mm).
//
// O O-grid tem 8 celulas tangenciais por quadrante (delta_theta=11.25 deg).
// Os centros de face no E-quadrante (raio r=2.5 mm) sao:
//   theta = -39.375, -28.125, -16.875, -5.625, +5.625, +16.875, +28.125, +39.375 deg
// Pegando theta = +/- 5.625 deg (centro em +x):
//   x_face = 2.5 * cos(5.625 deg) = 2.488 mm
//   y_face = 2.5 * sin(5.625 deg) = +/- 0.245 mm
// Box selecionado (em metros):
//   x : [+2.40e-3, +2.65e-3]   (filtra so theta = +/- 5.625 deg)
//   y : [-0.50e-3, +0.50e-3]   (captura ambos os lados de y=0)
//   z : [+12.0e-3, +18.0e-3]   (6 mm em z, centrado em z=15 mm = L/2)
// Resultado esperado: ~12 faces (6 niveis z x 2 faces theta).

actions
(
    {
        name    perturbation_strip;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { name dura_outer; }
    }
    {
        name    perturbation_strip;
        type    faceSet;
        action  subset;
        source  boxToFace;
        sourceInfo
        {
            box (2.40e-3  -0.50e-3  12.0e-3) (2.65e-3  +0.50e-3  18.0e-3);
        }
    }
);
