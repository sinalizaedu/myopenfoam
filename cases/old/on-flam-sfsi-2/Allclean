#!/bin/bash
# on-flam-sfsi-2 - limpa resultados (preserva condicoes iniciais em 0/).

cd "$(dirname "$0")/solid"

echo "Limpando on-flam-sfsi-2 (preservando 0/)..."
rm -rf \
    $(find . -maxdepth 1 -name '[0-9]*' ! -name '0' -type d) \
    log.* \
    postProcessing \
    constant/polyMesh
echo "Feito."
