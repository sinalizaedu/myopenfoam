# on-caso-2sP-temp (CCX) - limpa artefatos do solver.
# Mantem on-caso-2sP-temp.inp; regenera mesh/winkler/nsets no Allrun.

cd "$(dirname "$0")"

echo "Limpando on-caso-2sP-temp (CCX)..."
rm -f \
    on-caso-2sP-temp.frd on-caso-2sP-temp.dat on-caso-2sP-temp.cvg on-caso-2sP-temp.sta \
    on-caso-2sP-temp.12d on-caso-2sP-temp.eig on-caso-2sP-temp.txt on-caso-2sP-temp.rfn.frd \
    on-caso-2sP-temp.equ on-caso-2sP-temp.fbd \
    on-caso-2sP-temp_mesh.inp on-caso-2sP-temp_winkler.inp on-caso-2sP-temp_nsets.inp \
    on-caso-2sP-temp.pvd on-caso-2sP-temp.*.vtu on-caso-2sP-temp.*.vtk \
    log.ccx spooles.out
echo "Feito."
