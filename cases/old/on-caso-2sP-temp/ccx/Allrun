#!/bin/bash
# on-caso-2sP-temp (CCX) - PIC via inchaco higroscopico (swelling) no SAS.
# Variante sem perturbacao lateral; a PIC e' o analogo de dilatacao isotropica
# (*EXPANSION + campo de temperatura) imposto nos nos do SAS.
#
# Pipeline:
#   1) garante polyMesh em ../solid;
#   2) converte polyMesh -> CalculiX .inp (mesh + Winkler);
#   2b) gera os node-sets NALL + SAS_NODES (gen_sas_nodes.py);
#   3) roda ccx_preCICE standalone.

set -e
set -o pipefail
cd "$(dirname "$0")"

POLYMESH=../solid/constant/polyMesh

if [ ! -f "${POLYMESH}/points" ]; then
    echo "=== Gerando polyMesh em ../solid (blockMesh+topoSet+createPatch) ==="
    pushd ../solid >/dev/null
    blockMesh | tee log.blockMesh
    topoSet -dict system/topoSetDict_perturbation | tee log.topoSet
    createPatch -overwrite -dict system/createPatchDict_perturbation | tee log.createPatch
    popd >/dev/null
fi

echo "=== on-caso-2sP-temp (CCX): polyMesh -> CalculiX .inp ==="
python3 foam_polymesh_to_ccx_inp.py \
    --polymesh "${POLYMESH}" \
    --out-mesh on-caso-2sP-temp_mesh.inp \
    --out-winkler on-caso-2sP-temp_winkler.inp \
    --winkler-k 200000

echo "=== on-caso-2sP-temp (CCX): gerando node-sets NALL + SAS_NODES ==="
python3 gen_sas_nodes.py on-caso-2sP-temp_mesh.inp on-caso-2sP-temp_nsets.inp

echo "=== on-caso-2sP-temp (CCX): solver ccx_preCICE -i on-caso-2sP-temp ==="
ccx_preCICE -i on-caso-2sP-temp 2>&1 | tee log.ccx

if command -v ccx2paraview >/dev/null 2>&1; then
    ccx2paraview on-caso-2sP-temp.frd vtu 2>&1 | tail -5 || true
elif [ -x /tmp/ccx2pv/bin/ccx2paraview ]; then
    /tmp/ccx2pv/bin/ccx2paraview on-caso-2sP-temp.frd vtu 2>&1 | tail -5 || true
else
    echo "=== ccx2paraview nao encontrado no container (rode no HOST) ==="
fi

echo ""
echo "=== Concluido. on-caso-2sP-temp.{frd,dat,sta} gerados. ==="
