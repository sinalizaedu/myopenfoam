FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}

// sugestao - propriedades mecanicas multi-zona (6 materiais).
//
// As 5 zonas neuro-orbitais herdam de cases/on-mestrado/solid/constant/
// mechanicalProperties (Sigal 2004; Friberg & Lace 1988). A zona arteria
// herda de cases/ao-mestrado/solid/constant/mechanicalProperties (E=0.3 MPa,
// nu=0.49 — defensavel como "compliant artery worst case", referencia
// arteria oftalmica saudavel).
//
// Zona "arteria"  E=0.3 MPa, nu=0.49 — parede da arteria oftalmica
// Zona "on"       E=30 kPa,  nu=0.49 — tecido neural do nervo optico
// Zona "ons"      E=3 MPa,   nu=0.49 — bainha (pia + dura + subaracnoide)
// Zona "lc"       E=0.4 MPa, nu=0.49 — lamina cribrosa
// Zona "sclera"   E=5 MPa,   nu=0.45 — esclera posterior (anel)
// Zona "globo"    E=5 MPa,   nu=0.45 — casca do globo ocular
//
// Razao maxima de rigidez E_sclera/E_on = 5e6/3e4 = 167x. Soluvel pelo
// solver PCG+FDIC com relTol=0.05 (validado em on-mestrado).
//
// Gordura orbital MODELADA AGORA COMO SOLIDO 3D (paralelepipedo de gordura
// envolvendo arteria + nervo + ONS + globo, gerado em solid/staging/orbit_fat
// + integrado via mergeMeshes em solid/Allmesh). Patches externos do
// paralelepipedo (fat_x_min, fat_x_max, ...) sao fixedDisplacement = parede
// rigida da orbita ossea. Patches internos (fat_inner_arteria, fat_inner_nerve)
// sao solidContact com a arteria/nervo. Substitui a Winkler spring.
//
// Zona "orbital_fat"  E=900 Pa,  nu=0.45 — gordura orbital (Schoemaker 2006).

planeStress     no;

mechanical
(
    arteria
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 0.3e6;     // 0.3 MPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.49;
    }

    on
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1000;
        E       E   [ 1 -1 -2 0 0 0 0 ] 30e3;      // 30 kPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.49;
    }

    ons
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 3e6;       // 3 MPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.49;
    }

    lc
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 0.4e6;     // 0.4 MPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.49;
    }

    sclera
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;       // 5 MPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    globo
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;       // 5 MPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    orbital_fat
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 950;
        E       E   [ 1 -1 -2 0 0 0 0 ] 900;       // 900 Pa (Schoemaker 2006)
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }
);
