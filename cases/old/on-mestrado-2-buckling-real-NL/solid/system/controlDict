FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// on-mestrado-2-buckling-real: rampa quasi-estatica do P_fat (gordura
// orbital) de 0 a 3000 Pa em 10 passos de 1 unidade de tempo cada.
// Cada passo aumenta P_fat em 300 Pa (= 10% do upper bound de SANS).

application     solids4Foam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         10.0;

deltaT          1.0;

writeControl    timeStep;
writeInterval   1;
purgeWrite      0;

writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

libs ("$FOAM_CASE/../src/elasticFoundation/libsolidTractionElasticFoundation.so");

functions
{
    forces_globo
    {
        type            solidForcesDisplacements;
        libs            ("libsolids4FoamModels.so");
        historyPatch    globo_outer;
        writeControl    timeStep;
        writeInterval   1;
    }
    forces_apex_dura
    {
        type            solidForcesDisplacements;
        libs            ("libsolids4FoamModels.so");
        historyPatch    posterior_dura;
        writeControl    timeStep;
        writeInterval   1;
    }
    forces_apex_on
    {
        type            solidForcesDisplacements;
        libs            ("libsolids4FoamModels.so");
        historyPatch    posterior_on;
        writeControl    timeStep;
        writeInterval   1;
    }
    forces_apex_pia
    {
        type            solidForcesDisplacements;
        libs            ("libsolids4FoamModels.so");
        historyPatch    posterior_pia;
        writeControl    timeStep;
        writeInterval   1;
    }
}
