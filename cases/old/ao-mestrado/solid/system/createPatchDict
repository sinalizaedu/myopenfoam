FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

pointSync false;

patches
(
    {
        name        inner_cap_back;
        patchInfo   { type wall; }
        constructFrom set;
        set         artoph_end_back;
    }
    {
        name        inner_cap_front;
        patchInfo   { type wall; }
        constructFrom set;
        set         artoph_end_front;
    }
    {
        // FSI interface — name MUST match solid/system/preciceDict (patches lumen)
        // and solid/system/controlDict (solidForcesInner historyPatch lumen).
        name        lumen;
        patchInfo   { type wall; }
        constructFrom set;
        set         inner_wall_lateral;
    }
);
