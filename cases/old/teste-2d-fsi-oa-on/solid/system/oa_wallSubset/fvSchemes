FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system/oa_wallSubset";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default         steadyState;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         none;
    grad(D)         leastSquaresS4f;
    grad(DD)        leastSquaresS4f;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

snGradSchemes
{
    default         none;
    snGrad(D)       corrected;
    snGrad(DD)      corrected;
}

interpolationSchemes
{
    default         linear;
    interpolate(impK) harmonic;
}


