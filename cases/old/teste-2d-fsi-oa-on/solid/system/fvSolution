FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    // PERF v2: tolerance 1e-12 era exagero (cada solve linear pagava o preco
    // de ir ate 1e-12, mas o outer segregated so precisa 1e-4). relTol 0.1
    // tambem era frouxo demais (deixava cada outer corrector pouco convergido).
    "D|DD"
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-08;
        relTol          0.01;
    }
}

// PERF v2: 0.5 estava causando OSCILACAO no segregated loop
// (res alternando entre 0.005 e 0.04, nunca abaixo de 1e-4). Reduzir
// relaxation -> menos amplitude por iteracao -> converge em vez de oscilar.
// 0.3 e' o valor classico do linearGeometry; com a malha mais grossa e
// tolerance mais relaxada, deve convergir em ~100-500 corretores em vez
// de 5000.
relaxationFactors
{
    fields
    {
        "D|DD"  0.3;
    }
}
