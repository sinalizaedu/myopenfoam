/*--------------------------------*- C++ -*----------------------------------*\
| teste-2d-fsi-oa-on -- BACKUP da versao SEM contato (fixedDisplacement)       |
|                                                                              |
| Para usar: cp 0/D.without-contact 0/D                                        |
| (e remover/comentar o INITIAL_GAP no gen_teste_2d_fsi_blockmesh.py)          |
|                                                                              |
| Patches on_mestrado / oa_mestrado fixos em (0 0 0): tied constraint,         |
| util quando o contato real diverge ou para isolar a fisica da FSI.           |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}

dimensions      [ 0 1 0 0 0 0 0 ];

internalField   uniform (0 0 0);

boundaryField
{
    outer_top    { type fixedDisplacement; value uniform ( 0 0 0 ); }
    outer_bottom { type fixedDisplacement; value uniform ( 0 0 0 ); }

    outer_left_lower     { type solidSymmetry; patchType symmetry; value uniform ( 0 0 0 ); }
    outer_left_wall_inf  { type solidSymmetry; patchType symmetry; value uniform ( 0 0 0 ); }
    outer_left_wall_sup  { type solidSymmetry; patchType symmetry; value uniform ( 0 0 0 ); }
    outer_left_fat_above { type solidSymmetry; patchType symmetry; value uniform ( 0 0 0 ); }
    outer_right_lower    { type solidSymmetry; patchType symmetry; value uniform ( 0 0 0 ); }
    outer_right_wall_inf { type solidSymmetry; patchType symmetry; value uniform ( 0 0 0 ); }
    outer_right_wall_sup { type solidSymmetry; patchType symmetry; value uniform ( 0 0 0 ); }
    outer_right_fat_above{ type solidSymmetry; patchType symmetry; value uniform ( 0 0 0 ); }

    on_mestrado { type fixedDisplacement; value uniform ( 0 0 0 ); }
    oa_mestrado { type fixedDisplacement; value uniform ( 0 0 0 ); }

    lumen_bot { type solidForce; forceField solidForce; value uniform ( 0 0 0 ); }
    lumen_top { type solidForce; forceField solidForce; value uniform ( 0 0 0 ); }

    frontAndBack { type empty; }
}

