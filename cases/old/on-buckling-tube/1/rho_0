    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    xMinus
    {
        type            zeroGradient;
    }
    xPlus
    {
        type            zeroGradient;
    }
    yMinus
    {
        type            zeroGradient;
    }
    yPlus
    {
        type            zeroGradient;
    }
    imperfection
    {
        type            zeroGradient;
    }
}


