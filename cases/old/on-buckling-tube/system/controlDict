FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solids4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         40;

deltaT          1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    forces_top
    {
        type            solidForcesDisplacements;
        libs            ("libsolids4FoamModels.so");
        historyPatch    top;
        writeControl    timeStep;
        writeInterval   1;
    }
    forces_fixed
    {
        type            solidForcesDisplacements;
        libs            ("libsolids4FoamModels.so");
        historyPatch    fixed;
        writeControl    timeStep;
        writeInterval   1;
    }
}

