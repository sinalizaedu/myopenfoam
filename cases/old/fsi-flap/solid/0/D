FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Bar is clamped at its base — zero displacement
    bottom
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }

    // preCICE writes fluid forces here; solidForce BC converts them to traction
    interface
    {
        type            solidForce;
        forceField      solidForce;
        value           uniform (0 0 0);
    }

    frontAndBack
    {
        type            empty;
    }
}
