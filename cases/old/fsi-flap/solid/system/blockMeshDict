FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Flexible bar: x=[0.45,0.55] m, y=[0,0.2] m, z=[0,0.01] m
// Matches the slot in the fluid mesh exactly.
// Clamped at y=0 (bottom); left/top/right faces couple to fluid via preCICE.

scale   1;

vertices
(
    (0.45  0    0   )  // 0
    (0.55  0    0   )  // 1
    (0.55  0.2  0   )  // 2
    (0.45  0.2  0   )  // 3
    (0.45  0    0.01)  // 4
    (0.55  0    0.01)  // 5
    (0.55  0.2  0.01)  // 6
    (0.45  0.2  0.01)  // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (10 20 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    // Clamped base
    bottom
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }

    // Coupling surface: left side, top, right side all face the fluid
    interface
    {
        type wall;
        faces
        (
            (0 4 7 3)  // left face  x=0.45
            (3 7 6 2)  // top face   y=0.2
            (2 6 5 1)  // right face x=0.55
        );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)  // z=0
            (4 5 6 7)  // z=0.01
        );
    }
);
