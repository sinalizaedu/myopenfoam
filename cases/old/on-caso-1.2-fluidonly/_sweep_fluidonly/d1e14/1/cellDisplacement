FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "1";
    object      cellDisplacement;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (-0 -0 -0);

boundaryField
{
    inlet
    {
        type            cellMotion;
        value           uniform (0 0 0);
    }
    fsi_pia
    {
        type            cellMotion;
        value           uniform (0 0 0);
    }
    fsi_dura
    {
        type            cellMotion;
        value           uniform (0 0 0);
    }
    lid_wall_inner
    {
        type            cellMotion;
        value           uniform (0 0 0);
    }
    lid_wall_outer
    {
        type            cellMotion;
        value           uniform (0 0 0);
    }
    outlet_peri
    {
        type            cellMotion;
        value           uniform (0 0 0);
    }
}


