FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       surfaceScalarField;
    location    "1";
    object      meshPhi;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 3 -1 0 0 0 0];

oriented        oriented;

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    fsi_pia
    {
        type            calculated;
        value           uniform 0;
    }
    fsi_dura
    {
        type            calculated;
        value           uniform 0;
    }
    lid_wall_inner
    {
        type            calculated;
        value           uniform 0;
    }
    lid_wall_outer
    {
        type            calculated;
        value           uniform 0;
    }
    outlet_peri
    {
        type            calculated;
        value           uniform 0;
    }
}


