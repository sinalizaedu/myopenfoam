    (1.0  0    0.01) // 7
    (2.0  0    0.01) // 8
    (0    0.4  0.01) // 9
    (1.0  0.4  0.01) // 10
    (2.0  0.4  0.01) // 11
);

blocks
(
    hex (0 1 4 3  6 7 10 9)  (50 20 1) simpleGrading (1 1 1)
    hex (1 2 5 4  7 8 11 10) (50 20 1) simpleGrading (1 1 1)
);

