FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// pipe-fsi-mix solid: steady-state elastic deformation under IOP pressure load.
// Pressure values are injected by Allrun from the fluid simulation results.
// Single time step (deltaT=1, endTime=1) → static equilibrium solution.

application     solids4Foam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1;
deltaT          1;
writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
