FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

d2dt2Schemes
{
    default         steadyState;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         none;
    grad(D)         leastSquaresS4f;
    grad(DD)        leastSquaresS4f;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

snGradSchemes
{
    default         none;
    snGrad(D)       corrected;
    snGrad(DD)      corrected;
}

interpolationSchemes
{
    default         linear;
    // Harmonic interpolation of impK at material interfaces gives better convergence
    interpolate(impK)  harmonic;
}
