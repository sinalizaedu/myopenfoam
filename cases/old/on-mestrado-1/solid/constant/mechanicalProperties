FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}

// on-mestrado-1 - 5 zonas (on + pia lumped + lc + sclera lumped + globo).
//
// "Pia expandida": pia + SAS + dura fundidas num unico anel a E=3 MPa,
// nu=0.49 (Sigal et al. 2004, IOVS 45(12):4378-87).
// "Sclera lumped": sclera_peri + sclera_ring fundidas num unico anel a
// E=5 MPa, nu=0.45 (mesmo valor de -2, lumping puramente geometrico).
// "Globo": copiado integralmente do on-mestrado-2. Cap em z=30.30-30.80
// cobrindo todo o disco r=0-2.50, com mesmo material da sclera (E=5 MPa,
// nu=0.45) - so muda o cellZone para permitir analise por regiao.
//
// Zona "on"     - tecido neural do nervo optico
//   E = 30 kPa, nu = 0.49    Sigal et al. (2004)
//
// Zona "pia"    - bainha completa (pia + SAS + dura, lumped)
//   E = 3 MPa,  nu = 0.49    Sigal et al. (2004)
//
// Zona "lc"     - lamina cribrosa (z=30-30.30, disco poroso homogeneizado)
//   E = 0.4 MPa, nu = 0.49   Sigal et al. (2004) - propriedades efetivas
//
// Zona "sclera" - anel escleral posterior (z=30-30.30, peri+ring lumped)
//   E = 5 MPa,  nu = 0.45    Friberg & Lace (1988); Palko et al. (2014)
//
// Zona "globo"  - cap do globo posterior (z=30.30-30.80, disco completo)
//   E = 5 MPa,  nu = 0.45    Mesma sclera (continuidade material com
//                            sclera_peri/sclera_ring de -2).
//
// Gordura orbital: NAO modelada como solido. Entra como mola de Winkler
// em pia_outer (BC customizada solidTractionElasticFoundation, k=200 kPa/m).

planeStress     no;

mechanical
(
    on
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1000;
        E       E   [ 1 -1 -2 0 0 0 0 ] 30e3;    // 30 kPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.49;
    }

    pia
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 3e6;     // 3 MPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.49;
    }

    lc
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 0.4e6;   // 0.4 MPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.49;
    }

    sclera
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1400;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;     // 5 MPa
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    globo
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1400;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;     // 5 MPa - igual sclera
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }
);
