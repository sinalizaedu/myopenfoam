FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}

// on-mestrado-2 ANATOMICO - 8 zonas:
//   nervo+bainha (z=0-30mm): on, pia, sas, dura
//   junction LC+sclera (z=30-30.30mm): lc, sclera_peri, sclera_ring
//   casca do globo (z=30.30-30.80mm): globo
//
// E sclera_peri == sclera_ring (5 MPa) - split puramente geometrico para
// futura inclusao de anisotropia circumferencial Holzapfel.

planeStress     no;

mechanical
(
    on
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1000;
        E       E   [ 1 -1 -2 0 0 0 0 ] 30e3;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    pia
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 3e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    sas
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1000;
        E       E   [ 1 -1 -2 0 0 0 0 ] 100e3;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.30;
    }

    dura
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 3e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    lc
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 0.4e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    sclera_peri
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1400;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    sclera_ring
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1400;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    globo
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1400;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }
);
