#!/bin/bash
# Limpa resultados e mantem config (system/* + 0/*).
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

for d in solid fluid; do
  ( cd "$d" && rm -rf [1-9]* 0.[0-9]* constant/polyMesh 0/polyMesh \
                processor* postProcessing log.* )
done
rm -rf precice-Fluid-* precice-Solid-* precice-run
echo "Allclean done. (precice-config.xml mantido)"
