#!/bin/bash
# Build the solidTractionElasticFoundation custom boundary condition.
#
# Must be run inside the fsi container (where OpenFOAM + solids4foam headers
# are available). After building, the .so file is at:
#   $FOAM_USER_LIBBIN/libsolidTractionElasticFoundation.so
#
# Add the library to the case's system/controlDict via:
#   libs ("libsolidTractionElasticFoundation.so");

set -e

cd "$(dirname "$0")"

# Check that solids4Foam source tree is available
if [ ! -d /opt/of-user/src/solids4foam ]; then
    echo "ERROR: /opt/of-user/src/solids4foam not found."
    echo "Rebuild the Docker image after updating the Dockerfile."
    exit 1
fi

wmake libso
