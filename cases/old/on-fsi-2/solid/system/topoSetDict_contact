FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// on-mestrado-2 - localizacao SIMPLIFICADA do contato (sem arteria real).
//
// Geometria: eixo +X, plano y=0, a 3/4 do comprimento desde o canal optico
// (z=22.5 mm). z=0 e a extremidade engastada (canal optico, lado do cranio);
// z=30 e o lado do globo. A arteria oftalmica anatomicamente roca a bainha
// proxima ao globo antes de penetra-la.
//   P_contact_centro = (R_dura, 0, 22.5 mm) = (+2.5, 0, +22.5) mm
//   theta = 0 deg (alinhado com o eixo X)
//   sem componente y (axissimetrica em y)
//   Distancia ao globo: 7.5 mm (proximo da entrada anatomica)
//   Distancia ao engaste: 22.5 mm
//
// Selecionamos uma regiao ~1 mm x ~0.5 mm na superficie externa da dura
// (patch dura_outer, raio r=2.5 mm) ao redor de theta=0.
//
// O O-grid tem 8 celulas tangenciais por quadrante (delta_theta=11.25 deg).
// Os centros de celula em E-quadrante sao:
//    theta = -39.375, -28.125, -16.875, -5.625, +5.625, +16.875, +28.125, +39.375 deg
// Pegando theta = +/- 5.625 deg:
//    x_face = 2.5 * cos(5.625) = 2.488 mm
//    y_face = 2.5 * sin(5.625) = +/- 0.245 mm
// Box selecionado (em metros):
//   x : [+2.40e-3, +2.65e-3]   (filtra so theta = +/- 5.625 deg)
//   y : [-0.50e-3, +0.50e-3]   (captura ambos os lados de y=0)
//   z : [+22.0e-3, +23.0e-3]   (1 mm em z, centrado em z=22.5 mm)
// Resultado esperado: 2 faces, ~1 mm^2.

actions
(
    {
        name    contact_local;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { name dura_outer; }
    }
    {
        name    contact_local;
        type    faceSet;
        action  subset;
        source  boxToFace;
        sourceInfo
        {
            box (2.40e-3  -0.50e-3  22.0e-3) (2.65e-3  +0.50e-3  23.0e-3);
        }
    }
);
