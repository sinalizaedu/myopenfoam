#!/bin/bash
# G1: Gmsh transfinite 2D quads + Extrude revolve — single fused solid volume.
set -euo pipefail
cd "$(dirname "$0")"
# shellcheck source=../env.sh
source ../env.sh
GEOM=g1

for d in constant system initial; do
    if [ ! -d "$d" ]; then
        cp -r ../D1/"$d" .
    fi
done

mkdir -p geometry 0
python3 "$GEN_GMSH" --geometry "$GEOM" \
    --out-geo "geometry/o1_solid_${GEOM}.geo" \
    --out-msh "geometry/o1_solid_${GEOM}.msh" \
    --mesh

rm -rf constant/polyMesh
gmshToFoam "geometry/o1_solid_${GEOM}.msh" | tee log.gmshToFoam
changeDictionary | tee log.changeDictionary
transformPoints -rotate-y 90 | tee log.transformPoints
python3 "$EXP" --mode fields --case .
checkMesh | tee log.checkMesh
echo "=== G1 summary (transfinite extrude, 1 solid) ==="
grep -E "cells:|regions:|solid|coat|iris|ciliary|fsi_active|negative volume|Failed|Mesh OK|non-orthogonality Max" log.checkMesh || true
