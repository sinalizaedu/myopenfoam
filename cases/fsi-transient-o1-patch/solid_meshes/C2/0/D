FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    object D;
}

dimensions      [0 1 0 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    background
    {
        type        solidTraction;
        traction    uniform (0 0 0);
        pressure    uniform 0;
        value       uniform (0 0 0);
    }
    outer
    {
        type            fixedDisplacement;
        displacement    uniform (0 0 0);
        value           uniform (0 0 0);
    }
    fsi_active
    {
        type        solidForce;
        forceField  solidForce;
        value       uniform (0 0 0);
    }
}
