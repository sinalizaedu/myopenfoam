FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/domain1";
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    symmetry_0
    {
        type            symmetry;
    }
    symmetry_90
    {
        type            symmetry;
    }
    fsi_active
    {
        type            zeroGradient;
    }
    outer
    {
        type            zeroGradient;
    }
    fsi_iris
    {
        type            zeroGradient;
    }
    defaultFaces
    {
        type            zeroGradient;
    }
}


