FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}

// fsi-transient-o1-patch — six-zone solid (no lens / no fsi_lens Robin).
// Copied to solid/0/ after mesh import.

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    symmetry_0 { type symmetry; }
    symmetry_90 { type symmetry; }

    fsi_active
    {
        type        solidForce;
        forceField  solidForce;
        value       uniform (0 0 0);
    }

    fsi_iris
    {
        type            fixedDisplacement;
        displacement    uniform (0 0 0);
        value           uniform (0 0 0);
    }

    outer
    {
        type            fixedDisplacement;
        displacement    uniform (0 0 0);
        value           uniform (0 0 0);
    }

    defaultFaces
    {
        type        solidTraction;
        traction    uniform (0 0 0);
        pressure    uniform 0;
        value       uniform (0 0 0);
    }
}
