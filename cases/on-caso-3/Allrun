#!/bin/bash
# on-caso-3 - FLAMBAGEM com GORDURA ORBITAL EDEMACIADA (SANS).
# Derivado do on-caso-2: MESMA malha, MESMAS propriedades materiais do
# tubo (on/pia/sas/dura), MESMA cinematica de deslocamento axial imposto.
# UNICA diferenca: k da fundacao elastica de Winkler em dura_outer
# foi aumentado em 10x (200 kPa/m -> 2000 kPa/m) para emular a gordura
# orbital edemaciada da SANS (Reilly et al. 2023).
#
# Carregamento:
#   posterior_sas             : P_CSF = 1333 Pa (~10 mmHg) - PIC normal.
#   anterior_{on,pia,sas,dura}: rampa de Dz=0 -> -1 mm em 40 passos
#                               (constant/timeVsDisp, deltaT=1).
#   dura_outer                : Winkler 2000 kPa/m (gordura SANS).
#   perturbation_strip        : 10 Pa lateral em +X, z=[12;18] mm.
#
# Hipotese: P_cr sobe (mais carga para flambar) e o modo se torna mais
# focal (em vez de arco suave) porque a fundacao rigida penaliza
# comprimentos de onda longos.

set -e
set -o pipefail
cd "$(dirname "$0")/solid"

echo "=== on-caso-3 (SANS): blockMesh (4 zonas, ~16320 cells) ==="
blockMesh | tee log.blockMesh

echo "=== on-caso-3 (SANS): topoSet (extrai perturbation_strip do dura_outer) ==="
topoSet -dict system/topoSetDict_perturbation | tee log.topoSet

echo "=== on-caso-3 (SANS): createPatch (cria perturbation_strip) ==="
createPatch -overwrite -dict system/createPatchDict_perturbation | tee log.createPatch

echo "=== on-caso-3 (SANS): checkMesh ==="
checkMesh | tee log.checkMesh

echo "=== on-caso-3 (SANS): solids4Foam (40 passos com Dz ramped, k=2 MPa/m) ==="
solids4Foam | tee log.solids4Foam

echo ""
echo "=== Concluido. Resultados em solid/{1,2,...,40}/ ==="
echo ""
echo "Curva F_z(Dz) em postProcessing/forces_anterior_dura/0/forces_*.dat"
echo "Visualizar deformacao em ParaView: solid/on-caso-3.foam"
echo ""
echo "Para comparar com saudavel: python brunaStuff/analyze_on-caso-3.py"
