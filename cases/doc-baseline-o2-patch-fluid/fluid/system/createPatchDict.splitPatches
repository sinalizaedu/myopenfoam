FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

pointSync false;

patches
(
    {
        name            outlet_tm;
        patchInfo { type patch; }
        constructFrom set;
        set     outlet_tm_faces;
    }
    {
        name            ac_inlet;
        patchInfo { type patch; }
        constructFrom set;
        set     ac_inlet_faces;
    }
);
