FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

// Merge mislabelled gmsh ac_inlet / outlet_tm back into wall before re-carving.
pointSync false;

patches
(
    {
        name            wall;
        patchInfo { type wall; }
        constructFrom patches;
        patches (wall ac_inlet outlet_tm);
    }
);
