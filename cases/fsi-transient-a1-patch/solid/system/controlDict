FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// solids4Foam — timing patched by Allrun to match preCICE (startTime=0, fixed deltaT).

application     solids4Foam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2;
deltaT          0.05;
writeControl    runTime;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    preCICE_Adapter
    {
        type preciceAdapterFunctionObject;
        libs ("libpreciceAdapterFunctionObject.so");
    }
}
