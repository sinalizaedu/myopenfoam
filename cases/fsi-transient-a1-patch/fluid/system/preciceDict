FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      preciceDict;
}

// preCICE adapter — FLUID (pimpleFoam)
// Two-way: writes Force and reads Displacement on wall (↔ solid fsi_active).

participant   Fluid;

preciceConfig "../precice-config.xml";

modules ( FSI );

interfaces
{
    Interface1
    {
        mesh          Fluid-Mesh;
        patches       ( wall );
        locations     faceCenters;
        readData      ( Displacement );
        writeData     ( Force );
    }
}

FSI
{
    solverType              incompressible;
    rho                     rho [1 -3 0 0 0 0 0] 995;
}
