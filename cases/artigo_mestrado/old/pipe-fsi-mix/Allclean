#!/bin/bash
cd "${0%/*}" || exit 1
for d in fluid solid; do
    for td in "$d"/*/; do
        name=$(basename "$td")
        case "$name" in
            0) ;;
            *[0-9]*) rm -rf "$td" ;;
        esac
    done
    (cd "$d" && rm -rf log.* case.foam postProcessing constant/polyMesh 2>/dev/null)
done
echo "Cleaned."
