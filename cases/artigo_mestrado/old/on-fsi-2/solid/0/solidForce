FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      solidForce;
}

// Campo de forca FSI preenchido pelo preCICE OpenFOAM adapter.
// Le Force do fluido (pressao + tensao viscosa) nas 4 patches FSI e converte
// para traction nas paredes do solido.

dimensions      [ 1 1 -2 0 0 0 0 ];

internalField   uniform ( 0 0 0 );

boundaryField
{
    fsi_pia
    {
        type            calculated;
        value           uniform ( 0 0 0 );
    }
    fsi_dura
    {
        type            calculated;
        value           uniform ( 0 0 0 );
    }
    fsi_sclera_peri
    {
        type            calculated;
        value           uniform ( 0 0 0 );
    }
    fsi_sclera_ring
    {
        type            calculated;
        value           uniform ( 0 0 0 );
    }

    // Demais patches: zeroGradient (nao recebem Force do FSI)
    posterior_on        { type zeroGradient; }
    posterior_pia       { type zeroGradient; }
    posterior_dura      { type zeroGradient; }
    contact_local       { type zeroGradient; }
    dura_outer          { type zeroGradient; }
    sclera_ring_outer   { type zeroGradient; }
    globo_outer         { type zeroGradient; }
    anterior_globo      { type zeroGradient; }
}
