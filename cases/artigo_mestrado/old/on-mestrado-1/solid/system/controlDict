FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// on-mestrado-1 SEM SAS - apenas nervo + pia expandida (2 zonas).
// Sem CSF, sem SAS, sem pressao em ponto algum.
// Unica carga ativa: Winkler em pia_outer (gordura orbital).
//
// 1 unico timestep (analise quasi-estatica unica) - baseline estrutural.

application     solids4Foam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1.0;

deltaT          1.0;

writeControl    timeStep;
writeInterval   1;
purgeWrite      0;

writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// Carrega a BC customizada solidTractionElasticFoundation (mola de Winkler).
// Compilada uma vez em cases/on-mestrado/src/elasticFoundation/Allwmake;
// cases/on-mestrado-1/src e symlink para o mesmo diretorio.
libs ("$FOAM_CASE/../src/elasticFoundation/libsolidTractionElasticFoundation.so");
