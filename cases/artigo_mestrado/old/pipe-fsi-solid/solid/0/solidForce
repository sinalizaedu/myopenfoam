FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      solidForce;
}

// Force field written by the preCICE adapter each coupling step.
// Initialized to zero; solidForce BC reads this to apply traction on the barrier.

dimensions      [1 1 -2 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    bottom
    {
        type            calculated;
        value           uniform (0 0 0);
    }

    top
    {
        type            calculated;
        value           uniform (0 0 0);
    }

    interface_left
    {
        type            calculated;
        value           uniform (0 0 0);
    }

    interface_right
    {
        type            calculated;
        value           uniform (0 0 0);
    }

    frontAndBack
    {
        type            empty;
    }
}
