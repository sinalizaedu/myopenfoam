// Rampa de pressao da gordura orbital (motor da SANS).
// 0 -> 1500 Pa (SANS leve) -> 3000 Pa (SANS upper bound).
// 10 passos para Newton-Raphson estavel.
(
    ( 0      0     )
    ( 1      300   )
    ( 2      600   )
    ( 3      900   )
    ( 4     1200   )
    ( 5     1500   )
    ( 6     1800   )
    ( 7     2100   )
    ( 8     2400   )
    ( 9     2700   )
    ( 10    3000   )
)
