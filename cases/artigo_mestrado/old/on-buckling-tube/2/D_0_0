FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "2";
    object      D_0_0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    fixed
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    top
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    xMinus
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    xPlus
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    yMinus
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    yPlus
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    imperfection
    {
        type            calculated;
        value           uniform (0 0 0);
    }
}


