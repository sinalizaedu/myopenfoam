FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "D|DD"
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-09;
        relTol          0.1;
    }

    sigmaHyd
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-09;
        relTol          0.1;
    }
}

relaxationFactors
{
    // SUB-RELAXACAO de CAMPO essencial para Newton-Raphson em
    // problemas geometricamente nao-lineares - reduz amplificacao
    // de Jacobianos negativos transientes (modo de falha que
    // observamos em on-mestrado-2-buckling-NL).
    fields
    {
        "D|DD"       0.9;
    }
    equations
    {
    }
}

