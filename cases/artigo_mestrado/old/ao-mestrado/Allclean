#!/bin/bash
set -e
cd "$(dirname "$0")"
# Apaga somente diretorios de tempo > 0 (preserva pasta inicial '0/').
for side in fluid solid; do
  for d in "${side}"/[0-9]*; do
    [[ -d "$d" ]] || continue
    base="$(basename "$d")"
    [[ "$base" == "0" ]] && continue
    [[ "$base" =~ ^[0-9]+(\.[0-9]+)?$ ]] && rm -rf "$d"
  done
done
rm -rf fluid/log.* fluid/postProcessing fluid/precice-profiling fluid/dynamicCode 2>/dev/null || true
rm -rf solid/log.* solid/postProcessing solid/precice-profiling solid/dynamicCode 2>/dev/null || true
rm -f precice-run/*.log precice-run/*.json 2>/dev/null || true
echo "Cleaned time dirs and logs (polyMesh kept). Use rm -rf fluid/constant/polyMesh solid/constant/polyMesh to reset mesh."
