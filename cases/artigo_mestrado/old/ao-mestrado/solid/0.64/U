FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0.64";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inner_cap_back
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    inner_cap_front
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    lumen
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    arteria_externa
    {
        type            calculated;
        value           uniform (0 0 0);
    }
}


