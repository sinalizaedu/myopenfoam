FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// Stub controlDict minimo para blockMesh/topoSet/subsetMesh no diretorio
// staging. O run real acontece no caso pai (cases/sugestao/solid/), nao aqui.

application     blockMesh;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1;
deltaT          1;
writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;
