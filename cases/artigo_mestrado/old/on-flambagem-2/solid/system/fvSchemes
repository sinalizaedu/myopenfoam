FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

// Schemes do linearGeometryTotalDisplacement (config funcional do
// on-mestrado-2): leastSquaresS4f + Gauss linear uncorrected + impK harmonic.

d2dt2Schemes
{
    default         steadyState;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         none;
    grad(D)         leastSquaresS4f;
    grad(DD)        leastSquaresS4f;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear uncorrected;
}

snGradSchemes
{
    default         none;
    snGrad(D)       uncorrected;
    snGrad(DD)      uncorrected;
}

interpolationSchemes
{
    default         linear;
    interpolate(impK)  harmonic;
}
