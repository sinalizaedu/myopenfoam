// on-mestrado — nervo óptico + bainha + lâmina cribrosa + esclera + globo
//
// Geometria: O-grid com 5 zonas concêntricas/axiais (gordura é fundação elástica)
//
//   ON     (optic nerve)         : cilindro sólido,  r = 1.5 mm,  L = 30 mm
//   ONS    (optic nerve sheath)  : anel,  r = 1.5–2.5 mm,  L = 30 mm
//   lc     (lâmina cribrosa)     : disco, r = 0–1.5 mm, t = 0.5 mm  (z=30–30.5mm)
//   sclera (esclera posterior)   : anel,  r = 1.5–2.5mm, t = 0.5 mm (z=30–30.5mm)
//   globo  (casca do globo)      : disco, r = 0–2.5 mm, t = 0.5 mm  (z=30.5–31.0mm)
//
// A gordura orbital NAO e modelada como solido — entra como mola de Winkler
// no patch ons_outer (codedFixedValue: t = -k * D, k = 200 kPa/m).
// Vantagem: evita razao de rigidez extrema (E_fat/E_ons = 6000:1) que tornava
// a convergencia muito lenta.
//
// Patches:
//   posterior_on    — face z=0, ON zone      → fixedDisplacement
//   posterior_ons   — face z=0, ONS zone     → solidTraction P_CSF = 2667 Pa
//   contact_artoph  — ONS_E i_max (z=0–30)   → tração da artéria = 9000 Pa
//   ons_outer       — ONS N/W/S i_max        → mola de Winkler (gordura orbital)
//   sclera_outer    — sclera r=2.5mm (z=30–30.5) → solidTraction = 0
//   globo_outer     — globo r=2.5mm (z=30.5–31.0) → solidTraction = 0
//   anterior_globo  — face z=31.0mm (k_max globo) → fixedDisplacement (órbita)
//
// scale 0.001 → dimensões em mm

scale   0.001;

