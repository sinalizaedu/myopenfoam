FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant";
    object      solidProperties.withDefaultValues;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel      unsNonLinearGeometryTotalLagrangian;

unsNonLinearGeometryTotalLagrangianCoeffs
{
    nCorrectors     20000;
    solutionTolerance 0.0001;
    alternativeTolerance 1e-06;
    materialTolerance 0.0001;
    infoFrequency   200;
    stabilisation
    {
        type            RhieChow;
        scaleFactor     0.5;
    }
    dampingCoeff    dampingCoeff [ 0 0 -1 0 0 0 0 ] 0;
    minCorrectors   1;
    writeResidualField false;
    relaxationMethod fixed;
    restart         false;
    residualFile    false;
}


