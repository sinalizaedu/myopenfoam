FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}

// on-fsi-2 - 7 zonas solidas (a zona SAS e' fluido, nao aparece aqui).
//
// Mesmas propriedades do on-mestrado-2 (1:1) exceto que SAS deixa de ser
// um solido elastico (E=100kPa, nu=0.30) e passa a ser um fluido real
// modelado em fluid/constant/transportProperties.

planeStress     no;

mechanical
(
    on
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1000;
        E       E   [ 1 -1 -2 0 0 0 0 ] 30e3;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    pia
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 3e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    dura
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 3e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    lc
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 0.4e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    sclera_peri
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1400;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    sclera_ring
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1400;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }

    globo
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1400;
        E       E   [ 1 -1 -2 0 0 0 0 ] 5e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }
);
