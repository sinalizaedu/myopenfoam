FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      preciceDict;
}

// preCICE adapter (lado SOLIDO).
//   Le 'Force' do fluido nas patches lumen_bot e lumen_top.
//   Aplica a Force como campo 'solidForce' que e' lido pela BC solidForce
//   no 0/D.

preciceConfig "../precice-config.xml";

participant Solid;

modules (FSI);

interfaces
{
  Interface1
  {
    mesh              Solid-Mesh;
    patches           (lumen_bot lumen_top);
    locations         faceCenters;

    readData
    (
      Force
    );

    writeData         ();
  };
};

FSI
{
  solverType              solid;
  namePointDisplacement   pointD;
  nameCellDisplacement    D;
  nameForce               solidForce;
}
