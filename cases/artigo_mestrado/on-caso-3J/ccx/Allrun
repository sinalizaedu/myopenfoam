#!/bin/bash
# on-caso-3J (CCX) - GEOMETRIA do Caso 2J + CARGAS do Caso 3F.
#
# Combina:
#   - a TORTUOSIDADE EM "J" do Caso 2J (on-caso-2.2): a malha reta (eixo Z) e'
#     VARRIDA (sweep) ao longo de uma linha de centro curva e suave no plano XY,
#     reorientando cada secao perpendicular a tangente; dura ortotropica por
#     anel axial; Winkler UNIFORME (conversor da 2.2);
#   - o CARREGAMENTO do Caso 3F (on-caso-3): compressao axial clinica
#     (Dy=-1.0 mm) + pressao focal da arteria oftalmica (P_contact, patch
#     contact_local carved de dura_outer) + PIC 1333 Pa.
#
# Geometria do "J" (igual ao Caso 2J):
#   - globo na ORIGEM (0,0), tangente do nervo apontando -Y (nervo desce);
#   - linha de centro = arco de CURVATURA CONSTANTE, giro turn=-53.130102 deg
#     -> apice em (-13.29, -26.57) mm; razao 2:1; comprimento de arco e raio
#     da secao PRESERVADOS (~30.8 mm, 2.5 mm), espessura no eixo Z.
#
# Pipeline:
#   1) Garante a malha solids4Foam em ../solid (blockMesh + perturbacao + CONTATO
#      se polyMesh nao existir) -- o patch contact_local e' esculpido aqui;
#   2) Converte polyMesh -> CalculiX .inp (mesh + Winkler springs) RETO,
#      com o conversor da 2.2 (Winkler UNIFORME em toda a parede da dura;
#      contact_local fica fora do Winkler e vira CONTACT_LOCAL_SURF);
#   3) Gera as orientacoes ortotropicas da dura por anel axial (curva em J);
#   4) Varre (sweep) mesh E winkler ao longo da linha de centro em "J" com a
#      MESMA referencia de comprimento de arco (--zmax);
#   5) Injeta P_CONTACT na clausula *DSLOAD CONTACT_LOCAL_SURF;
#   6) Roda ccx_preCICE standalone; renomeia outputs com sufixo _$OUT_TAG.
#
# Parametros (env vars, opcionais):
#   P_CONTACT  : pressao focal da arteria oftalmica [Pa]. Default = 9034 (~67 mmHg).
#   OUT_TAG    : sufixo dos arquivos de saida.            Default = "" (sem sufixo).
#   WINKLER_K  : rigidez do Winkler [Pa/m].               Default = 200000 (baseline).
#
# Uso (sweep externo):
#   P_CONTACT=0     OUT_TAG=Pc0     ./Allrun
#   P_CONTACT=18068 OUT_TAG=Pc18068 ./Allrun
#
# Inputs:
#   on-caso-3J.inp               (hand-written, *INCLUDE para os 3 abaixo)
#   on-caso-3J_mesh.inp          (gerado pelo conversor + sweep)
#   on-caso-3J_winkler.inp       (gerado pelo conversor + sweep)
#   on-caso-3J_dura_orient.inp   (gerado por gen_dura_ortho_orient.py)
#
# Outputs:
#   on-caso-3J${OUT_TAG:+_$OUT_TAG}.frd/.dat/.cvg/.sta  + log.ccx${OUT_TAG:+_$OUT_TAG}

set -e
set -o pipefail
cd "$(dirname "$0")"

P_CONTACT=${P_CONTACT:-9034}
OUT_TAG=${OUT_TAG:-}
WINKLER_K=${WINKLER_K:-200000}

POLYMESH=../solid/constant/polyMesh

# parametros do sweep em "J" (ver cabecalho)
THETA0=-90
TURN=-53.130102

# ---------- 1) garante que polyMesh existe (com patch de CONTATO) ----------
if [ ! -f "${POLYMESH}/points" ]; then
    echo "=== Gerando polyMesh em ../solid (blockMesh + perturbacao + contato) ==="
    pushd ../solid >/dev/null
    blockMesh | tee log.blockMesh
    topoSet -dict system/topoSetDict_perturbation | tee log.topoSet.perturbation
    createPatch -overwrite -dict system/createPatchDict_perturbation | tee log.createPatch.perturbation
    # contact_local: patch focal para P_contact (arteria oftalmica, ~9 kPa)
    topoSet -dict system/topoSetDict_contact | tee log.topoSet.contact
    createPatch -overwrite -dict system/createPatchDict_contact | tee log.createPatch.contact
    popd >/dev/null
fi

# ---------- 2) converte polyMesh -> CCX .inp (tubo RETO, Winkler UNIFORME) ----------
echo "=== on-caso-3J (CCX): polyMesh -> CalculiX .inp  [k_winkler=${WINKLER_K} Pa/m] ==="
python3 foam_polymesh_to_ccx_inp.py \
    --polymesh "${POLYMESH}" \
    --out-mesh on-caso-3J_mesh.inp \
    --out-winkler on-caso-3J_winkler.inp \
    --winkler-k "${WINKLER_K}"

# ---------- 3) referencia de comprimento de arco (ZMAX = globo) ----------
ZMAX=$(python3 -c "from warp_centerline_sweep import max_z; from pathlib import Path; print(max_z(Path('on-caso-3J_mesh.inp').read_text().splitlines()))")
echo "=== on-caso-3J (CCX): sweep em J (theta0=${THETA0} turn=${TURN}, zmax=${ZMAX}) ==="

# ---------- 3b) dura ORTOTROPICA: orientacoes cilindricas por anel ----------
# Roda sobre a malha RETA (antes do warp): le o z0 original de cada elemento da
# dura p/ agrupar aneis axiais; os eixos C(s)/t(s) sao analiticos (referencial curvo).
echo "=== on-caso-3J (CCX): orientacoes ortotropicas da dura por anel axial ==="
python3 gen_dura_ortho_orient.py \
    --mesh on-caso-3J_mesh.inp \
    --out on-caso-3J_dura_orient.inp \
    --theta0-deg "${THETA0}" --turn-deg "${TURN}" --zmax "${ZMAX}"

# ---------- 3c) tortuosidade em "J" (sweep da linha de centro) ----------
# mesh E winkler varridos com o MESMO --zmax -> nos ghost do Winkler seguem a dura curva.
python3 warp_centerline_sweep.py \
    --mesh on-caso-3J_mesh.inp \
    --theta0-deg "${THETA0}" --turn-deg "${TURN}" --zmax "${ZMAX}"
python3 warp_centerline_sweep.py \
    --mesh on-caso-3J_winkler.inp \
    --theta0-deg "${THETA0}" --turn-deg "${TURN}" --zmax "${ZMAX}"

# ---------- 4) injeta P_CONTACT na clausula *DSLOAD ----------
echo "=== on-caso-3J (CCX): P_CONTACT = ${P_CONTACT} Pa (arteria oftalmica) ==="
sed -i -E "s|^CONTACT_LOCAL_SURF, P, .*\$|CONTACT_LOCAL_SURF, P, ${P_CONTACT}|" on-caso-3J.inp
grep -n "^CONTACT_LOCAL_SURF, P," on-caso-3J.inp || true

# ---------- 5) roda CalculiX ----------
echo "=== on-caso-3J (CCX): solver ccx_preCICE -i on-caso-3J  [tag=${OUT_TAG:-<none>}] ==="
rm -f on-caso-3J.frd on-caso-3J.dat on-caso-3J.cvg on-caso-3J.sta \
      on-caso-3J.12d on-caso-3J.pvd on-caso-3J.*.vtu log.ccx
ccx_preCICE -i on-caso-3J 2>&1 | tee log.ccx

# ---------- 5b) renomeia outputs com tag (se OUT_TAG nao vazio) ----------
if [ -n "${OUT_TAG}" ]; then
    echo "=== on-caso-3J (CCX): renomeando outputs _${OUT_TAG} ==="
    for ext in frd dat cvg sta; do
        if [ -f "on-caso-3J.${ext}" ]; then
            cp "on-caso-3J.${ext}" "on-caso-3J_${OUT_TAG}.${ext}"
        fi
    done
    cp log.ccx "log.ccx_${OUT_TAG}"
    FRD_OUT="on-caso-3J_${OUT_TAG}.frd"
else
    FRD_OUT="on-caso-3J.frd"
fi

# ---------- 6) converte .frd -> .vtu (opcional, no host) ----------
if command -v ccx2paraview >/dev/null 2>&1; then
    echo "=== on-caso-3J (CCX): convertendo ${FRD_OUT} -> .vtu (ParaView) ==="
    ccx2paraview "${FRD_OUT}" vtu 2>&1 | tail -5 || true
elif [ -x /tmp/ccx2pv/bin/ccx2paraview ]; then
    /tmp/ccx2pv/bin/ccx2paraview "${FRD_OUT}" vtu 2>&1 | tail -5 || true
else
    echo "=== on-caso-3J (CCX): ccx2paraview nao encontrado dentro do container ==="
    echo "    (rode no HOST: cd cases/on-caso-3J/ccx && /tmp/ccx2pv/bin/ccx2paraview ${FRD_OUT} vtu)"
fi

echo ""
echo "=== Concluido. Arquivos de saida: ==="
echo "  on-caso-3J.frd  - campos CalculiX (U, RF, S, E)"
echo "  on-caso-3J.dat  - totais RF/U nos NSETs monitorados"
echo "  on-caso-3J.sta  - status de convergencia por incremento Riks (lam_final)"
echo ""
echo "Geometria (so' a malha varrida, sem rodar):"
echo "  python3 ../../../brunaStuff/inp_to_vtk.py --inp on-caso-3J_mesh.inp --out on-caso-3J_geom.vtu"
