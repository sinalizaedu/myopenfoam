#!/bin/bash
# on-caso-3-sf (CCX) - "on-caso-3 Sem Forca (frontal)".
#
# Identico ao on-caso-3, mas SEM nenhuma forca/compressao axial vinda da frente
# (sem Dz prescrito, sem CLOAD EOM no globo). Unica carga ativa = P_contact
# LATERAL da arteria oftalmica (DSLOAD CONTACT_LOCAL_SURF), varrida 0..18068 Pa.
# Mantem Winkler 200 kPa/m (baseline, igual ao 3S), perturbacao lateral, engaste
# posterior e confinamento lateral XY do globo (eixo Z livre).
#
# Pipeline:
#   1) Garante polyMesh em ../solid (gera com blockMesh+topoSet+createPatch se
#      polyMesh nao existir; aqui ja vem copiado do on-caso-3);
#   2) Converte polyMesh -> CalculiX .inp (mesh + Winkler springs);
#   3) Sed-injeta P_CONTACT na clausula *DSLOAD CONTACT_LOCAL_SURF;
#   4) Roda ccx_preCICE standalone;
#   5) Renomeia outputs com sufixo _$OUT_TAG.
#
# Parametros (env vars, opcionais):
#   P_CONTACT  : pressao focal lateral da arteria oftalmica [Pa]. Default = 9034.
#   OUT_TAG    : sufixo dos arquivos de saida.                    Default = "".
#   WINKLER_K  : rigidez do Winkler [Pa/m].                       Default = 200000.
#
# Uso (sweep externo):
#   P_CONTACT=0     OUT_TAG=Pc0     ./Allrun
#   P_CONTACT=18068 OUT_TAG=Pc18068 ./Allrun

set -e
set -o pipefail
cd "$(dirname "$0")"

P_CONTACT=${P_CONTACT:-9034}
OUT_TAG=${OUT_TAG:-}
WINKLER_K=${WINKLER_K:-200000}

POLYMESH=../solid/constant/polyMesh

# ---------- 1) garante que polyMesh existe ----------
if [ ! -f "${POLYMESH}/points" ]; then
    echo "=== Gerando polyMesh em ../solid (blockMesh+topoSet+createPatch) ==="
    pushd ../solid >/dev/null
    blockMesh | tee log.blockMesh
    topoSet -dict system/topoSetDict_perturbation | tee log.topoSet.perturbation
    createPatch -overwrite -dict system/createPatchDict_perturbation | tee log.createPatch.perturbation
    topoSet -dict system/topoSetDict_contact | tee log.topoSet.contact
    createPatch -overwrite -dict system/createPatchDict_contact | tee log.createPatch.contact
    popd >/dev/null
fi

# ---------- 2) converte polyMesh -> CCX .inp ----------
echo "=== on-caso-3-sf (CCX): polyMesh -> CalculiX .inp  [k_winkler=${WINKLER_K} Pa/m] ==="
python3 foam_polymesh_to_ccx_inp.py \
    --polymesh "${POLYMESH}" \
    --out-mesh on-caso-3-sf_mesh.inp \
    --out-winkler on-caso-3-sf_winkler.inp \
    --winkler-k "${WINKLER_K}"

# ---------- 3a) injeta P_CONTACT na clausula *DSLOAD ----------
echo "=== on-caso-3-sf (CCX): P_CONTACT = ${P_CONTACT} Pa (arteria oftalmica, LATERAL) ==="
sed -i -E "s|^CONTACT_LOCAL_SURF, P, .*\$|CONTACT_LOCAL_SURF, P, ${P_CONTACT}|" on-caso-3-sf.inp
grep -n "^CONTACT_LOCAL_SURF, P," on-caso-3-sf.inp || true

# ---------- 3b) roda CalculiX ----------
echo "=== on-caso-3-sf (CCX): solver ccx_preCICE -i on-caso-3-sf  [tag=${OUT_TAG:-<none>}] ==="
rm -f on-caso-3-sf.frd on-caso-3-sf.dat on-caso-3-sf.cvg on-caso-3-sf.sta on-caso-3-sf.12d \
      on-caso-3-sf.pvd on-caso-3-sf.*.vtu log.ccx
ccx_preCICE -i on-caso-3-sf 2>&1 | tee log.ccx

# ---------- 3c) renomeia outputs com tag (se OUT_TAG nao vazio) ----------
if [ -n "${OUT_TAG}" ]; then
    echo "=== on-caso-3-sf (CCX): renomeando outputs _${OUT_TAG} ==="
    for ext in frd dat cvg sta; do
        if [ -f "on-caso-3-sf.${ext}" ]; then
            cp "on-caso-3-sf.${ext}" "on-caso-3-sf_${OUT_TAG}.${ext}"
        fi
    done
    cp log.ccx "log.ccx_${OUT_TAG}"
fi

# ---------- 4) converte .frd -> .vtu (opcional, no host) ----------
FRD_TARGET="on-caso-3-sf${OUT_TAG:+_$OUT_TAG}.frd"
if command -v ccx2paraview >/dev/null 2>&1; then
    echo "=== on-caso-3-sf (CCX): convertendo ${FRD_TARGET} -> .vtu (ParaView) ==="
    ccx2paraview "${FRD_TARGET}" vtu 2>&1 | tail -5 || true
elif [ -x /tmp/ccx2pv/bin/ccx2paraview ]; then
    /tmp/ccx2pv/bin/ccx2paraview "${FRD_TARGET}" vtu 2>&1 | tail -5 || true
else
    echo "=== on-caso-3-sf (CCX): ccx2paraview nao encontrado dentro do container ==="
    echo "    (rode no HOST: cd cases/on-caso-3-sf/ccx && /tmp/ccx2pv/bin/ccx2paraview ${FRD_TARGET} vtu)"
fi

echo ""
echo "=== Concluido. Arquivos de saida: ==="
echo "  on-caso-3-sf.frd  - campos CalculiX (U, RF, S, E)"
echo "  on-caso-3-sf.dat  - totais RF/U nos NSETs monitorados"
echo "  on-caso-3-sf.sta  - status de convergencia por incremento Riks (lam_final)"
echo ""
echo "Analise: python3 brunaStuff/analyze_on-caso-3-sf_pcontact_sweep.py"
