FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

// on-caso-3 - cria patch local 'contact_local' a partir do faceSet definido
// em topoSetDict_contact. As faces movidas saem do dura_outer (Winkler nelas
// fica desativado automaticamente pelo conversor) e passam ao novo patch que
// recebera *DSLOAD pressao P_contact = 9034 Pa em on-caso-3.inp
// (analogue ao cases/on-caso-1/solid/0/D para a arteria oftalmica).

pointSync   false;

patches
(
    {
        name            contact_local;
        patchInfo       { type wall; }
        constructFrom   set;
        set             contact_local;
    }
);
