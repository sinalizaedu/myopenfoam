FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

// Schemes alinhados com tutoriais NL do solids4Foam (e.g. longWall).
// leastSquares + corrected estabiliza a compressao em neoHookean; Gauss linear
// + uncorrected disparam NaN no NL com contrast E_dura/E_sas = 30.
// Cada zona tem subset proprio em system/{zona}Subset/ para o controle local
// do gradiente nas zonas com nu->0.5 (anti-checkerboarding).

d2dt2Schemes
{
    default         steadyState;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         leastSquares;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

snGradSchemes
{
    default         corrected;
}

interpolationSchemes
{
    default         linear;
}
