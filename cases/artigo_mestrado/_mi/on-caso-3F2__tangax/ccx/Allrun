#!/bin/bash
# on-caso-3F2 (CCX) - 3F com DOIS contatos arteriais antissimetricos (modo S).
#
# Pipeline (roda dentro do container fsi-openfoam):
#   1) blockMesh (malha radial radpia2dura3, copiada do 3F de producao);
#   2) topoSet+createPatch da perturbation_strip (leftover, sem carga; so' tira
#      Winkler daquelas faces -- herdado do on-caso-3);
#   3) topoSet+createPatch do contato 1 (contact_local,  +X, z=22.5 mm);
#   4) topoSet+createPatch do contato 2 (contact_local2, -X, z= 7.5 mm);
#   5) converte polyMesh -> CalculiX .inp (mesh + Winkler springs). O conversor
#      emite automaticamente *SURFACE CONTACT_LOCAL2_SURF para o novo patch;
#   6) (opcional) injeta P_CONTACT nos DOIS *DSLOAD se a env var for passada;
#   7) roda ccx_preCICE standalone;
#   8) renomeia outputs com sufixo _$OUT_TAG.
#
# Parametros (env vars, opcionais):
#   P_CONTACT  : pressao focal dos DOIS contatos arteriais [Pa]. Default = mantem
#                o valor ja' gravado no deck (9034).
#   OUT_TAG    : sufixo dos arquivos de saida.                   Default = "".
#   WINKLER_K  : rigidez do Winkler [Pa/m].                      Default = 200000.

set -e
set -o pipefail
cd "$(dirname "$0")"

DECK=on-caso-3F2
P_CONTACT=${P_CONTACT:-}
OUT_TAG=${OUT_TAG:-}
WINKLER_K=${WINKLER_K:-200000}

POLYMESH=../solid/constant/polyMesh

# ---------- 1-4) gera polyMesh + patches (sempre regenera p/ ter 2 contatos) ----------
echo "=== on-caso-3F2: blockMesh + topoSet/createPatch (pert + 2 contatos) ==="
pushd ../solid >/dev/null
blockMesh | tee log.blockMesh
topoSet     -dict system/topoSetDict_perturbation    | tee log.topoSet.perturbation
createPatch -overwrite -dict system/createPatchDict_perturbation | tee log.createPatch.perturbation
topoSet     -dict system/topoSetDict_contact         | tee log.topoSet.contact
createPatch -overwrite -dict system/createPatchDict_contact      | tee log.createPatch.contact
topoSet     -dict system/topoSetDict_contact2        | tee log.topoSet.contact2
createPatch -overwrite -dict system/createPatchDict_contact2     | tee log.createPatch.contact2
popd >/dev/null

# ---------- 5) converte polyMesh -> CCX .inp ----------
echo "=== on-caso-3F2 (CCX): polyMesh -> CalculiX .inp  [k_winkler=${WINKLER_K} Pa/m] ==="
python3 foam_polymesh_to_ccx_inp.py \
    --polymesh "${POLYMESH}" \
    --out-mesh ${DECK}_mesh.inp \
    --out-winkler ${DECK}_winkler.inp \
    --winkler-k "${WINKLER_K}"

echo "=== Conferindo que CONTACT_LOCAL2_SURF foi emitida ==="
grep -n "CONTACT_LOCAL2_SURF\|CONTACT_LOCAL_SURF" ${DECK}_mesh.inp | head

# ---------- 6) injeta P_CONTACT nos DOIS contatos (se passado) ----------
if [ -n "${P_CONTACT}" ]; then
    echo "=== on-caso-3F2 (CCX): P_CONTACT = ${P_CONTACT} Pa nos DOIS contatos ==="
    sed -i -E "s|^CONTACT_LOCAL_SURF, P, .*\$|CONTACT_LOCAL_SURF, P, ${P_CONTACT}|"  ${DECK}.inp
    sed -i -E "s|^CONTACT_LOCAL2_SURF, P, .*\$|CONTACT_LOCAL2_SURF, P, ${P_CONTACT}|" ${DECK}.inp
fi
grep -n "^CONTACT_LOCAL2\?_SURF, P," ${DECK}.inp || true

# ---------- 7) roda CalculiX ----------
echo "=== on-caso-3F2 (CCX): ccx_preCICE -i ${DECK}  [tag=${OUT_TAG:-<none>}] ==="
rm -f ${DECK}.frd ${DECK}.dat ${DECK}.cvg ${DECK}.sta ${DECK}.12d log.ccx
ccx_preCICE -i ${DECK} 2>&1 | tee log.ccx

# ---------- 8) renomeia outputs com tag ----------
if [ -n "${OUT_TAG}" ]; then
    echo "=== on-caso-3F2 (CCX): renomeando outputs _${OUT_TAG} ==="
    for ext in frd dat cvg sta; do
        [ -f "${DECK}.${ext}" ] && cp "${DECK}.${ext}" "${DECK}_${OUT_TAG}.${ext}"
    done
    cp log.ccx "log.ccx_${OUT_TAG}"
fi

echo ""
echo "=== Concluido. .sta tail: ==="
tail -3 ${DECK}.sta 2>/dev/null || echo "no .sta"
