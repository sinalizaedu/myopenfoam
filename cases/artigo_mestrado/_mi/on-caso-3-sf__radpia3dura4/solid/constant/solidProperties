FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      solidProperties;
}

// on-caso-3 - FLAMBAGEM por deslocamento axial imposto na tampa anterior,
// SEM FSI (solido puro).
//
// HISTORICO DE TENTATIVAS DE NL GEOMETRY (todas falharam):
//   * alpha_D=0.3, neoHookean, 4 zonas anatomicas: NaN em iter 10-20 do Time=1.
//     Step norm 0.095 m = 1000x o Dz imposto (checkerboarding FVM segregado).
//   * alpha_D=0.1: NaN em iter 260 do Time=1. So adiou a explosao; residual
//     subiu de 0.024 (iter 130) para 1.4 (iter 250) antes de divergir.
//   * Mesmo bug do solver segregado documentado em on-mestrado-2-buckling-NL,
//     -homog, -real-NL e relatorio_sans.tex secao "Limitacao numerica".
//
// FALLBACK ADOTADO: linearGeometryTotalDisplacement (mesmo solver do
// on-mestrado-2-buckling-real, que convergiu em 215s). Captura k_axial via
// rampa quasi-estatica. P_cr estimado posteriormente por Euler analitico
// P_cr = pi^2 EI / (KL)^2 a partir do EI da dura (camada estrutural
// dominante, 72% da rigidez total). Este e o caminho hibrido validado no
// relatorio_sans.tex - linear + Euler ao inves de NL direto.

solidModel      linearGeometryTotalDisplacement;

linearGeometryTotalDisplacementCoeffs
{
    nCorrectors             10000;
    solutionTolerance       1e-06;
    alternativeTolerance    1e-06;
    materialTolerance       1e-06;
    infoFrequency           50;
}
