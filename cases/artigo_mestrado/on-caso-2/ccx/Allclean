#!/bin/bash
# on-caso-2 (CCX) - limpa artefatos do solver CalculiX.
# Mantem on-caso-2.inp (hand-written); regenera on-caso-2_{mesh,winkler}.inp no Allrun.

cd "$(dirname "$0")"

echo "Limpando on-caso-2 (CCX)..."
rm -f \
    on-caso-2.frd on-caso-2.dat on-caso-2.cvg on-caso-2.sta \
    on-caso-2.12d on-caso-2.eig on-caso-2.txt on-caso-2.rfn.frd \
    on-caso-2.equ on-caso-2.fbd \
    on-caso-2_mesh.inp on-caso-2_winkler.inp \
    on-caso-2.pvd on-caso-2.*.vtu on-caso-2.*.vtk \
    log.ccx spooles.out
echo "Feito."
