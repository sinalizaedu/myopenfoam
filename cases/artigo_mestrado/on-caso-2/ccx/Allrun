#!/bin/bash
# on-caso-2 (CCX) - flambagem axial NLGEOM com CalculiX 2.20.
#
# Pipeline:
#   1) Garante que existe a malha solids4Foam em ../solid (gera com blockMesh
#      se polyMesh nao existir);
#   2) Converte polyMesh -> CalculiX .inp (mesh + Winkler springs);
#   3) Roda ccx_preCICE em modo standalone (sem precice-config.xml).
#
# Inputs:
#   on-caso-2.inp                (hand-written, contem *INCLUDE para os 2 abaixo)
#   on-caso-2_mesh.inp           (gerado pelo conversor)
#   on-caso-2_winkler.inp        (gerado pelo conversor)
#
# Outputs:
#   on-caso-2.frd  (campos U, RF, S, E para ParaView/cgx)
#   on-caso-2.dat  (totais de RF nos NSETs ANTERIOR_*)
#   on-caso-2.cvg  (residuos por iteracao)
#   on-caso-2.sta  (status de convergencia por incremento)
#   log.ccx        (stdout completo)

set -e
set -o pipefail
cd "$(dirname "$0")"

POLYMESH=../solid/constant/polyMesh

# ---------- 1) garante que polyMesh existe ----------
if [ ! -f "${POLYMESH}/points" ]; then
    echo "=== Gerando polyMesh em ../solid (blockMesh; SEM perturbation_strip) ==="
    pushd ../solid >/dev/null
    blockMesh | tee log.blockMesh
    # perturbation_strip REMOVIDO desta variante: dura_outer fica inteira e
    # recebe Winkler em todas as faces (sem carga lateral artificial).
    popd >/dev/null
fi

# ---------- 2) converte polyMesh -> CCX .inp ----------
echo "=== on-caso-2 (CCX): polyMesh -> CalculiX .inp ==="
# Conversor copiado para dentro do caso (cases/ e o unico volume do container).
# Master fica em brunaStuff/foam_polymesh_to_ccx_inp.py.
python3 foam_polymesh_to_ccx_inp.py \
    --polymesh "${POLYMESH}" \
    --out-mesh on-caso-2_mesh.inp \
    --out-winkler on-caso-2_winkler.inp \
    --winkler-k 200000

# ---------- 3) roda CalculiX ----------
echo "=== on-caso-2 (CCX): solver ccx_preCICE -i on-caso-2 ==="
ccx_preCICE -i on-caso-2 2>&1 | tee log.ccx

# ---------- 4) converte .frd -> .vtu (opcional, no host) ----------
# .frd e formato CalculiX nativo. ParaView nao le diretamente; convertemos
# para .vtu com ccx2paraview se disponivel (no host, nao no container).
if command -v ccx2paraview >/dev/null 2>&1; then
    echo "=== on-caso-2 (CCX): convertendo .frd -> .vtu (ParaView) ==="
    ccx2paraview on-caso-2.frd vtu 2>&1 | tail -5 || true
elif [ -x /tmp/ccx2pv/bin/ccx2paraview ]; then
    /tmp/ccx2pv/bin/ccx2paraview on-caso-2.frd vtu 2>&1 | tail -5 || true
else
    echo "=== on-caso-2 (CCX): ccx2paraview nao encontrado dentro do container ==="
    echo "    (esperado - rode 'cd cases/on-caso-2/ccx && /tmp/ccx2pv/bin/ccx2paraview on-caso-2.frd vtu' no HOST)"
fi

echo ""
echo "=== Concluido. Arquivos de saida: ==="
echo "  on-caso-2.frd  - campos CalculiX (cgx -c se disponivel)"
echo "  on-caso-2.pvd  - ParaView Data (abre direto no ParaView)"
echo "  on-caso-2.dat  - totais RF no engaste posterior (curva F_z(Dz))"
echo "  on-caso-2.sta  - status de convergencia por incremento Riks"
echo ""
echo "Analise: python3 ../../../brunaStuff/analyze_on-caso-2_ccx.py"
