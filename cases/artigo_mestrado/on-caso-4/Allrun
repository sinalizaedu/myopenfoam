#!/bin/bash
# on-caso-4 - "inchaco SANS dirige AREA e FORCA de contato".
#
# Pipeline CalculiX (Riks NLGEOM), herdado do on-caso-3-sf (sem forca frontal).
# A P_contact da arteria oftalmica nao e' mais fixa: por estagio de SANS o
# inchaco da bainha (P_CSF) define a area do patch e a forca de contato.
#
# Rodada unica (estagio baseline 1g: P_CSF=1333, P_contact=9034 Pa):
#   cd ccx && ./Allrun
#
# Sweep completo pelos estagios de SANS:
#   bash brunaStuff/sweep_on-caso-4.sh
#
# Este wrapper apenas delega para o ccx/Allrun (rodada unica).

set -e
cd "$(dirname "$0")/ccx"
exec ./Allrun
