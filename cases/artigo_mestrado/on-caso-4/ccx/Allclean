#!/bin/bash
# on-caso-4 (CCX) - limpa artefatos do solver CalculiX.
# Mantem on-caso-4.inp (hand-written); regenera os _{mesh,winkler}.inp no Allrun.

cd "$(dirname "$0")"

echo "Limpando on-caso-4 (CCX)..."
rm -f \
    on-caso-4.frd on-caso-4.dat on-caso-4.cvg on-caso-4.sta \
    on-caso-4.12d on-caso-4.eig on-caso-4.txt on-caso-4.rfn.frd \
    on-caso-4.equ on-caso-4.fbd \
    on-caso-4_mesh.inp on-caso-4_winkler.inp \
    on-caso-4.pvd on-caso-4.*.vtu on-caso-4.*.vtk \
    on-caso-4_S*.frd on-caso-4_S*.dat on-caso-4_S*.cvg on-caso-4_S*.sta \
    on-caso-4_S*.*.vtu \
    log.ccx log.ccx_S* spooles.out
echo "Feito."
