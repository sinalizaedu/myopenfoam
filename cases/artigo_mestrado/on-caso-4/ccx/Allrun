#!/bin/bash
# on-caso-4 (CCX) - "inchaco SANS dirige AREA e FORCA de contato".
#
# Herdado do on-caso-3-sf (sem forca frontal: sem Dz, sem CLOAD EOM). A novidade
# fisica: a P_contact da arteria oftalmica NAO e' mais uma carga fixa num patch
# fixo. Por ESTAGIO DE SANS, o inchaco da bainha (dirigido por P_CSF) define:
#   - a AREA do contact_local (box do topoSetDict_contact, ampliado);
#   - a FORCA de contato (P_contact = k_art*delta).
# Ambos crescem ACOPLADOS ao inchaco. Mantem Winkler SANS 2 MPa/m, engaste
# posterior e confinamento lateral XY do globo (eixo Z livre).
#
# Pipeline:
#   1) (Re)gera polyMesh em ../solid com o box de contato do estagio
#      (blockMesh+topoSet+createPatch). REMESH=1 forca regeneracao;
#   2) Converte polyMesh -> CalculiX .inp (mesh + Winkler springs);
#   3) Sed-injeta P_CONTACT (arteria) e P_CSF (inchaco) nas clausulas *DSLOAD;
#   4) Roda ccx_preCICE standalone;
#   5) Renomeia outputs com sufixo _$OUT_TAG.
#
# Parametros (env vars, opcionais):
#   P_CONTACT   : pressao focal da arteria oftalmica [Pa].   Default = 9034.
#   P_CSF       : pressao do LCR na parede interna da dura    Default = 1333.
#                 (MOTOR do inchaco) [Pa].
#   CONTACT_BOX : box do contact_local (2 triplas de cantos,  Default = baseline.
#                 metros) p/ topoSetDict_contact. Define a AREA do estagio.
#   WINKLER_K   : rigidez do Winkler [Pa/m].                  Default = 2000000.
#   OUT_TAG     : sufixo dos arquivos de saida.               Default = "".
#   REMESH      : 1 = regenera polyMesh (necessario p/ aplicar Default = 1.
#                 CONTACT_BOX); 0 = reusa polyMesh existente.
#
# Uso (sweep externo, por estagio de SANS):
#   P_CSF=1333 P_CONTACT=9034  CONTACT_BOX='...' OUT_TAG=S0_baseline ./Allrun
#   P_CSF=3800 P_CONTACT=13551 CONTACT_BOX='...' OUT_TAG=S2_upper    ./Allrun

set -e
set -o pipefail
cd "$(dirname "$0")"

P_CONTACT=${P_CONTACT:-9034}
P_CSF=${P_CSF:-1333}
WINKLER_K=${WINKLER_K:-2000000}
OUT_TAG=${OUT_TAG:-}
REMESH=${REMESH:-1}
# Box baseline (estagio 0): 2 faces ~1.2 mm^2, theta=+/-7.5 deg, z=22.5 mm.
CONTACT_BOX=${CONTACT_BOX:-'(2.40e-3 -0.50e-3 21.0e-3) (2.60e-3 0.50e-3 24.0e-3)'}

POLYMESH=../solid/constant/polyMesh

# ---------- 1) (re)gera polyMesh com o box de contato do estagio ----------
if [ "${REMESH}" = "1" ] || [ ! -f "${POLYMESH}/points" ]; then
    echo "=== on-caso-4: (re)gerando polyMesh com CONTACT_BOX=${CONTACT_BOX} ==="
    pushd ../solid >/dev/null
    # injeta o box do estagio no topoSetDict_contact (linha 'box (..) (..);')
    sed -i -E "s|box \(.*\);|box ${CONTACT_BOX};|" system/topoSetDict_contact
    grep -nE "box \(.*\);" system/topoSetDict_contact || true
    blockMesh | tee log.blockMesh
    # NB: caso 4 NAO usa o perturbation_strip (a carga de perturbacao foi removida
    # ja no on-caso-3-sf). Mante-lo so removeria Winkler de 8 faces em +X (z 10-20)
    # e roubaria faces do patch de contato quando ele cresce axialmente. Logo so
    # carvamos o contact_local; toda a dura_outer restante recebe Winkler.
    topoSet -dict system/topoSetDict_contact | tee log.topoSet.contact
    createPatch -overwrite -dict system/createPatchDict_contact | tee log.createPatch.contact
    popd >/dev/null
fi

# ---------- 2) converte polyMesh -> CCX .inp ----------
echo "=== on-caso-4 (CCX): polyMesh -> CalculiX .inp  [k_winkler=${WINKLER_K} Pa/m] ==="
python3 foam_polymesh_to_ccx_inp.py \
    --polymesh "${POLYMESH}" \
    --out-mesh on-caso-4_mesh.inp \
    --out-winkler on-caso-4_winkler.inp \
    --winkler-k "${WINKLER_K}"

# ---------- 3a) injeta P_CONTACT (arteria) e P_CSF (inchaco) nos *DSLOAD ----------
echo "=== on-caso-4 (CCX): P_CONTACT = ${P_CONTACT} Pa (arteria) | P_CSF = ${P_CSF} Pa (inchaco) ==="
sed -i -E "s|^CONTACT_LOCAL_SURF, P, .*\$|CONTACT_LOCAL_SURF, P, ${P_CONTACT}|" on-caso-4.inp
sed -i -E "s|^DURA_INNER_SURF, P, .*\$|DURA_INNER_SURF, P, ${P_CSF}|" on-caso-4.inp
grep -nE "^(CONTACT_LOCAL_SURF|DURA_INNER_SURF), P," on-caso-4.inp || true

# ---------- 3b) roda CalculiX ----------
echo "=== on-caso-4 (CCX): solver ccx_preCICE -i on-caso-4  [tag=${OUT_TAG:-<none>}] ==="
rm -f on-caso-4.frd on-caso-4.dat on-caso-4.cvg on-caso-4.sta on-caso-4.12d \
      on-caso-4.pvd on-caso-4.*.vtu log.ccx
ccx_preCICE -i on-caso-4 2>&1 | tee log.ccx

# ---------- 3c) renomeia outputs com tag (se OUT_TAG nao vazio) ----------
if [ -n "${OUT_TAG}" ]; then
    echo "=== on-caso-4 (CCX): renomeando outputs _${OUT_TAG} ==="
    for ext in frd dat cvg sta; do
        if [ -f "on-caso-4.${ext}" ]; then
            cp "on-caso-4.${ext}" "on-caso-4_${OUT_TAG}.${ext}"
        fi
    done
    cp log.ccx "log.ccx_${OUT_TAG}"
fi

# ---------- 4) converte .frd -> .vtu (opcional, no host) ----------
FRD_TARGET="on-caso-4${OUT_TAG:+_$OUT_TAG}.frd"
if command -v ccx2paraview >/dev/null 2>&1; then
    echo "=== on-caso-4 (CCX): convertendo ${FRD_TARGET} -> .vtu (ParaView) ==="
    ccx2paraview "${FRD_TARGET}" vtu 2>&1 | tail -5 || true
elif [ -x /tmp/ccx2pv/bin/ccx2paraview ]; then
    /tmp/ccx2pv/bin/ccx2paraview "${FRD_TARGET}" vtu 2>&1 | tail -5 || true
else
    echo "=== on-caso-4 (CCX): ccx2paraview nao encontrado dentro do container ==="
    echo "    (rode no HOST: cd cases/on-caso-4/ccx && /tmp/ccx2pv/bin/ccx2paraview ${FRD_TARGET} vtu)"
fi

echo ""
echo "=== Concluido. Arquivos de saida: ==="
echo "  on-caso-4.frd  - campos CalculiX (U, RF, S, E)"
echo "  on-caso-4.dat  - totais RF/U nos NSETs monitorados"
echo "  on-caso-4.sta  - status de convergencia por incremento Riks (lam_final)"
echo ""
echo "Analise: python3 brunaStuff/analyze_on-caso-4.py"
