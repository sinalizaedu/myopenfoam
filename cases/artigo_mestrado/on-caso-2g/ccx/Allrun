#!/bin/bash
# on-caso-2g (CCX) - sweep de rigidez da gordura orbital (Winkler k).
#
# Uso:
#   WINKLER_K=200000 OUT_TAG=k200k ./Allrun
#
# O Allrun roda CalculiX com k=$WINKLER_K Pa/m e renomeia os outputs
# com sufixo _$OUT_TAG (.dat, .frd, .sta, .cvg, .vtu).
#
# A polyMesh e' gerada apenas na primeira chamada (cache em ../solid).

set -e
set -o pipefail
cd "$(dirname "$0")"

WINKLER_K=${WINKLER_K:-200000}
OUT_TAG=${OUT_TAG:-default}

POLYMESH=../solid/constant/polyMesh

# ---------- 1) garante que polyMesh existe ----------
if [ ! -f "${POLYMESH}/points" ]; then
    echo "=== Gerando polyMesh em ../solid (blockMesh+topoSet+createPatch) ==="
    pushd ../solid >/dev/null
    blockMesh | tee log.blockMesh
    topoSet -dict system/topoSetDict_perturbation | tee log.topoSet
    createPatch -overwrite -dict system/createPatchDict_perturbation | tee log.createPatch
    popd >/dev/null
fi

# ---------- 2) converte polyMesh -> CCX .inp (regenera Winkler com k atual) ----------
echo "=== on-caso-2g (CCX): polyMesh -> CalculiX .inp  [k_winkler=${WINKLER_K} Pa/m] ==="
python3 foam_polymesh_to_ccx_inp.py \
    --polymesh "${POLYMESH}" \
    --out-mesh on-caso-2_mesh.inp \
    --out-winkler on-caso-2_winkler.inp \
    --winkler-k "${WINKLER_K}"

# ---------- 3) roda CalculiX ----------
echo "=== on-caso-2g (CCX): solver ccx_preCICE -i on-caso-2  [tag=${OUT_TAG}] ==="
rm -f on-caso-2.frd on-caso-2.dat on-caso-2.cvg on-caso-2.sta on-caso-2.12d \
      on-caso-2.pvd on-caso-2.*.vtu log.ccx
ccx_preCICE -i on-caso-2 2>&1 | tee log.ccx

# ---------- 4) renomeia outputs com tag ----------
echo "=== on-caso-2g (CCX): renomeando outputs _${OUT_TAG} ==="
for ext in frd dat cvg sta; do
    if [ -f "on-caso-2.${ext}" ]; then
        cp "on-caso-2.${ext}" "on-caso-2_${OUT_TAG}.${ext}"
    fi
done
cp log.ccx "log.ccx_${OUT_TAG}"

# ---------- 5) ccx2paraview se disponivel (host) ----------
if command -v ccx2paraview >/dev/null 2>&1; then
    ccx2paraview "on-caso-2_${OUT_TAG}.frd" vtu 2>&1 | tail -3 || true
elif [ -x /tmp/ccx2pv/bin/ccx2paraview ]; then
    /tmp/ccx2pv/bin/ccx2paraview "on-caso-2_${OUT_TAG}.frd" vtu 2>&1 | tail -3 || true
fi

echo ""
echo "=== Concluido [k=${WINKLER_K} Pa/m, tag=${OUT_TAG}]. Outputs: ==="
ls -la on-caso-2_${OUT_TAG}.* 2>/dev/null
