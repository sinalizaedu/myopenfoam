/* solids4Foam source tree (must be present in container at this path) */
S4F_SRC = /opt/of-user/src/solids4foam/src

EXE_INC = \
    -DOPENFOAM_COM \
    -DOPENFOAM_NOT_EXTEND \
    -Wno-old-style-cast -Wno-deprecated-declarations \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(S4F_SRC)/solids4FoamModels/lnInclude \
    -I$(S4F_SRC)/blockCoupledSolids4FoamTools/lnInclude \
    -I$(S4F_SRC)/ThirdParty/eigen3

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -L$(FOAM_USER_LIBBIN) \
    -L/opt/of-user/lib \
    -lsolids4FoamModels
