// on-caso-3J - cria faceSet 'contact_local' em dura_outer para servir de
// patch de carga focal da arteria oftalmica (P_contact).
//
// >>> CASO 3J: a arteria e' posicionada para pressionar a dura NO PLANO do "J",
// >>> no lado CONVEXO/externo do arco, empurrando para DENTRO contra a curvatura
// >>> (oposta ao "C" axial). No referencial RETO (antes do warp) isso e' a face
// >>> +Y, porque o sweep mapeia o +Y original -> direcao +X no plano do "J"
// >>> (lado convexo); o +X original viraria a espessura (+Z, fora do plano).
//
// Geometria (referencial RETO):
//   centro = (0, R_dura=2.5 mm, z=22.5 mm), theta=+90 deg (+Y)
//   distancia ao globo (z=30) ~ 7.5 mm -- proximo da entrada anatomica
//                                          da arteria oftalmica na bainha
//   distancia ao engaste (z=0) ~ 22.5 mm
//
// Grid:
//   - dura_outer tem 6 cels tangenciais por quadrante -> dtheta=15 deg
//     Cels centradas em theta = 90 +/- 7.5 deg (mais proximas de +Y):
//       x_face = 2.5 * cos(82.5 ou 97.5) = +/-0.326 mm
//       y_face = 2.5 * sin(82.5 ou 97.5) = 2.479 mm
//   - 10 cels axiais sobre z=0-30 mm -> dz=3 mm
//     Cel n=7 com centro EXATO em z=22.5 mm.
//
// Box selecionado (metros): captura 2 faces (1 axial x 2 tang).
//   x : [-0.50e-3, +0.50e-3]   (ambos os lados de x=0, theta = 90 +/- 7.5 deg)
//   y : [+2.40e-3, +2.60e-3]   (filtra a face +Y em r=2.5 mm)
//   z : [+21.0e-3, +24.0e-3]   (3 mm em z, centrado em z=22.5 mm)
// Resultado esperado: 2 faces, ~1.2 mm^2 de superficie de contato.

actions
(
    {
        name    contact_local;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { name dura_outer; }
    }
    {
        name    contact_local;
        type    faceSet;
        action  subset;
        source  boxToFace;
        sourceInfo
        {
            box (-0.50e-3  2.40e-3  21.0e-3) (0.50e-3  2.60e-3  24.0e-3);
        }
    }
);
