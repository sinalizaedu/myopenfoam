#!/bin/bash
# on-caso-3-inv (CCX) - limpa artefatos do solver CalculiX.
# Mantem on-caso-3-inv.inp (hand-written); regenera on-caso-3-inv_{mesh,winkler}.inp no Allrun.

cd "$(dirname "$0")"

echo "Limpando on-caso-3-inv (CCX)..."
rm -f \
    on-caso-3-inv.frd on-caso-3-inv.dat on-caso-3-inv.cvg on-caso-3-inv.sta \
    on-caso-3-inv.12d on-caso-3-inv.eig on-caso-3-inv.txt on-caso-3-inv.rfn.frd \
    on-caso-3-inv.equ on-caso-3-inv.fbd \
    on-caso-3-inv_mesh.inp on-caso-3-inv_winkler.inp \
    on-caso-3-inv.pvd on-caso-3-inv.*.vtu on-caso-3-inv.*.vtk \
    log.ccx spooles.out
echo "Feito."
