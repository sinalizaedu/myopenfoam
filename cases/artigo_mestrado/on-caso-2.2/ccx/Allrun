#!/bin/bash
# on-caso-2.2 (CCX) - flambagem/tortuosidade NLGEOM com CalculiX 2.20.
#
# Variante de on-caso-2 V14b (8 zonas: SAS solido + dura + EOM): em vez do CLOAD
# perturbador antissimetrico, a imperfeicao geometrica e a TORTUOSIDADE EM "J"
# do nervo optico (folga/slack anatomica, item 2). A malha reta (eixo Z) e
# VARRIDA (sweep) ao longo de uma linha de centro curva e suave no plano XY,
# reorientando cada secao transversal perpendicular a tangente.
#
# Geometria do "J" (aprovada pela Bruna):
#   - globo na ORIGEM (0,0), tangente do nervo apontando -Y (nervo desce);
#   - linha de centro = arco de CURVATURA CONSTANTE (suave), giro total
#     turn=-53.130102 deg -> apice em (-13.29, -26.57) mm;
#   - razao 2:1 (queda vertical = 2x deslocamento horizontal);
#   - comprimento de arco = comprimento do tubo reto (~30.8 mm, preservado);
#   - raio da secao transversal = igual ao tubo reto (2.5 mm), espessura em Z.
#
# Pipeline:
#   1) Garante a malha solids4Foam em ../solid (blockMesh se polyMesh nao existir);
#   2) Converte polyMesh -> CalculiX .inp (mesh + Winkler springs) RETO;
#   3) Varre (sweep) mesh E winkler ao longo da linha de centro em "J" com a
#      MESMA referencia de comprimento de arco (--zmax), para os nos ghost do
#      Winkler seguirem a dura curva sem pre-tensao espuria;
#   4) Roda ccx_preCICE em modo standalone (sem precice-config.xml).
#
# Inputs:
#   on-caso-2.2.inp                (hand-written, *INCLUDE para os 2 abaixo)
#   on-caso-2.2_mesh.inp           (gerado pelo conversor + sweep)
#   on-caso-2.2_winkler.inp        (gerado pelo conversor + sweep)
#
# Outputs:
#   on-caso-2.2.frd  (campos U, RF, S, E para ParaView/cgx)
#   on-caso-2.2.dat  (totais de RF nos NSETs)
#   on-caso-2.2.cvg  (residuos por iteracao)
#   on-caso-2.2.sta  (status de convergencia por incremento)
#   log.ccx          (stdout completo)

set -e
set -o pipefail
cd "$(dirname "$0")"

# --------------------------------------------------------------------------
# Parametrizacao de Winkler (gordura orbital). Uso:
#   WINKLER_K=200000 OUT_TAG=k200k ./Allrun
# Quando OUT_TAG != default, os outputs (.frd/.dat/.cvg/.sta/.vtu e log.ccx)
# sao copiados com sufixo _$OUT_TAG. A malha em "J" e a dura ortotropica sao
# regeradas a cada chamada (so o Winkler depende de k), reutilizando a
# polyMesh cacheada em ../solid.
# --------------------------------------------------------------------------
WINKLER_K=${WINKLER_K:-200000}
OUT_TAG=${OUT_TAG:-default}

POLYMESH=../solid/constant/polyMesh

# parametros do sweep em "J" (ver cabecalho)
THETA0=-90
TURN=-53.130102

# ---------- 1) garante que polyMesh existe ----------
if [ ! -f "${POLYMESH}/points" ]; then
    echo "=== Gerando polyMesh em ../solid (blockMesh+topoSet+createPatch) ==="
    pushd ../solid >/dev/null
    blockMesh | tee log.blockMesh
    topoSet -dict system/topoSetDict_perturbation | tee log.topoSet
    createPatch -overwrite -dict system/createPatchDict_perturbation | tee log.createPatch
    popd >/dev/null
fi

# ---------- 2) converte polyMesh -> CCX .inp (tubo RETO) ----------
echo "=== on-caso-2.2 (CCX): polyMesh -> CalculiX .inp  [k_winkler=${WINKLER_K} Pa/m] ==="
# Conversor copiado para dentro do caso (cases/ e o unico volume do container).
# Master fica em brunaStuff/foam_polymesh_to_ccx_inp.py.
python3 foam_polymesh_to_ccx_inp.py \
    --polymesh "${POLYMESH}" \
    --out-mesh on-caso-2.2_mesh.inp \
    --out-winkler on-caso-2.2_winkler.inp \
    --winkler-k "${WINKLER_K}"

# ---------- 3) tortuosidade em "J" (sweep da linha de centro) ----------
# Mede s = ZMAX - z a partir do globo (z=ZMAX). ZMAX vem da malha (tem o globo
# ate z=30.8); o winkler so vai ate z=30, por isso passamos o MESMO --zmax aos
# dois -> nos ghost do Winkler seguem exatamente os nos da dura curva.
ZMAX=$(python3 -c "from warp_centerline_sweep import max_z; from pathlib import Path; print(max_z(Path('on-caso-2.2_mesh.inp').read_text().splitlines()))")
echo "=== on-caso-2.2 (CCX): sweep em J (theta0=${THETA0} turn=${TURN}, zmax=${ZMAX}) ==="

# ---------- 3b) dura ORTOTROPICA: orientacoes cilindricas por anel ----------
# Roda sobre a malha RETA (antes do warp): le o z0 original de cada elemento da
# dura p/ agrupar aneis axiais; os eixos C(s)/t(s) sao analiticos (referencial
# curvo), com os MESMOS theta0/turn/zmax do warp.
echo "=== on-caso-2.2 (CCX): orientacoes ortotropicas da dura por anel axial ==="
python3 gen_dura_ortho_orient.py \
    --mesh on-caso-2.2_mesh.inp \
    --out on-caso-2.2_dura_orient.inp \
    --theta0-deg "${THETA0}" --turn-deg "${TURN}" --zmax "${ZMAX}"

# Master em brunaStuff/warp_centerline_sweep.py.
python3 warp_centerline_sweep.py \
    --mesh on-caso-2.2_mesh.inp \
    --theta0-deg "${THETA0}" --turn-deg "${TURN}" --zmax "${ZMAX}"
python3 warp_centerline_sweep.py \
    --mesh on-caso-2.2_winkler.inp \
    --theta0-deg "${THETA0}" --turn-deg "${TURN}" --zmax "${ZMAX}"

# ---------- 4) roda CalculiX ----------
echo "=== on-caso-2.2 (CCX): solver ccx_preCICE -i on-caso-2.2  [tag=${OUT_TAG}] ==="
rm -f on-caso-2.2.frd on-caso-2.2.dat on-caso-2.2.cvg on-caso-2.2.sta \
      on-caso-2.2.12d on-caso-2.2.pvd on-caso-2.2.*.vtu log.ccx
ccx_preCICE -i on-caso-2.2 2>&1 | tee log.ccx

# ---------- 4b) renomeia outputs com tag (sweep de Winkler) ----------
if [ "${OUT_TAG}" != "default" ]; then
    echo "=== on-caso-2.2 (CCX): renomeando outputs _${OUT_TAG} ==="
    for ext in frd dat cvg sta; do
        if [ -f "on-caso-2.2.${ext}" ]; then
            cp "on-caso-2.2.${ext}" "on-caso-2.2_${OUT_TAG}.${ext}"
        fi
    done
    cp log.ccx "log.ccx_${OUT_TAG}"
    FRD_OUT="on-caso-2.2_${OUT_TAG}.frd"
else
    FRD_OUT="on-caso-2.2.frd"
fi

# ---------- 5) converte .frd -> .vtu (opcional, no host) ----------
if command -v ccx2paraview >/dev/null 2>&1; then
    echo "=== on-caso-2.2 (CCX): convertendo ${FRD_OUT} -> .vtu (ParaView) ==="
    ccx2paraview "${FRD_OUT}" vtu 2>&1 | tail -5 || true
elif [ -x /tmp/ccx2pv/bin/ccx2paraview ]; then
    /tmp/ccx2pv/bin/ccx2paraview "${FRD_OUT}" vtu 2>&1 | tail -5 || true
else
    echo "=== on-caso-2.2 (CCX): ccx2paraview nao encontrado dentro do container ==="
    echo "    (esperado - rode 'cd cases/on-caso-2.2/ccx && /tmp/ccx2pv/bin/ccx2paraview ${FRD_OUT} vtu' no HOST)"
fi

echo ""
echo "=== Concluido. Arquivos de saida: ==="
echo "  on-caso-2.2.frd  - campos CalculiX (cgx -c se disponivel)"
echo "  on-caso-2.2.pvd  - ParaView Data (abre direto no ParaView)"
echo "  on-caso-2.2.dat  - totais RF no engaste posterior (curva F(D))"
echo "  on-caso-2.2.sta  - status de convergencia por incremento Riks"
echo ""
echo "Geometria (so' a malha varrida, sem rodar): "
echo "  python3 ../../../brunaStuff/inp_to_vtk.py --inp on-caso-2.2_mesh.inp --out on-caso-2.2_geom.vtu"
