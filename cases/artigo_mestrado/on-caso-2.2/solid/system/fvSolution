FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    "D|DD"
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-09;
        relTol          0.1;
    }

    sigmaHyd
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-09;
        relTol          0.1;
    }
}

// Sub-relaxacao branda apropriada para linearGeometry. alpha_D=0.9 e o valor
// canonico do tutorial s4f para problemas elasticos lineares com BCs de
// deslocamento imposto. (Os valores agressivos 0.1-0.3 eram para domar o
// checkerboarding do solver NL segregado, que foi descartado.)
relaxationFactors
{
    fields
    {
        D       0.9;
    }
}
