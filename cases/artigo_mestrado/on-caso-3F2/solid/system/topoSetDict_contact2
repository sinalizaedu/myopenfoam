// on-caso-3F2 - SEGUNDA carga focal da arteria oftalmica (contato OPOSTO).
// Cria faceSet 'contact_local2' em dura_outer, no lado -X, z=7.5 mm. Junto com
// o 'contact_local' (+X, z=22.5 mm) forma um par ANTISSIMETRICO em relacao ao
// meio-vao (z=15 mm = L/2): dois empurroes focais em lados/alturas opostos ->
// imperfeicao de modo n=2 que seleciona o padrao em "S" (duas meias-ondas).
//
// Geometria (espelha o topoSetDict_contact, refletido em z e em theta):
//   centro = (R_dura=2.5 mm, theta=180 deg, z=7.5 mm)  [lado -X]
//   simetrico a contact_local (+X, z=22.5 mm) em torno de z=15 mm.
//
// Grid (igual ao contact_local, malha radpia2dura3 = tang/axial da producao):
//   - dura_outer: 6 cels tangenciais/quadrante -> dtheta=15 deg.
//     Cels mais proximas de -X centradas em theta = 172.5 e 187.5 deg:
//       x_face = 2.5*cos(172.5) = -2.479 mm ; y_face = 2.5*sin(172.5) = +/-0.326 mm
//   - 10 cels axiais sobre z=0-30 mm -> dz=3 mm, centros em z=1.5,4.5,7.5,...
//     Pegando a cel n=3 com centro EXATO em z=7.5 mm.
//
// Box selecionado (metros): captura 2 faces (1 axial x 2 tang) no lado -X.
//   x : [-2.60e-3, -2.40e-3]   (filtra theta = 172.5/187.5 deg em r=2.5 mm)
//   y : [-0.50e-3, +0.50e-3]   (ambos os lados de y=0)
//   z : [+6.0e-3, +9.0e-3]     (3 mm em z, centrado em z=7.5 mm)
// Resultado esperado: 2 faces, ~1.2 mm^2 de superficie de contato.

actions
(
    {
        name    contact_local2;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { name dura_outer; }
    }
    {
        name    contact_local2;
        type    faceSet;
        action  subset;
        source  boxToFace;
        sourceInfo
        {
            box (-2.60e-3  -0.50e-3  6.0e-3) (-2.40e-3  +0.50e-3  9.0e-3);
        }
    }
);
