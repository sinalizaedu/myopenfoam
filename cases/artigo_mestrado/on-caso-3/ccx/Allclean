#!/bin/bash
# on-caso-3 (CCX) - limpa artefatos do solver CalculiX.
# Mantem on-caso-3.inp (hand-written); regenera on-caso-3_{mesh,winkler}.inp no Allrun.

cd "$(dirname "$0")"

echo "Limpando on-caso-3 (CCX)..."
rm -f \
    on-caso-3.frd on-caso-3.dat on-caso-3.cvg on-caso-3.sta \
    on-caso-3.12d on-caso-3.eig on-caso-3.txt on-caso-3.rfn.frd \
    on-caso-3.equ on-caso-3.fbd \
    on-caso-3_mesh.inp on-caso-3_winkler.inp \
    on-caso-3.pvd on-caso-3.*.vtu on-caso-3.*.vtk \
    log.ccx spooles.out
echo "Feito."
