#!/bin/bash
# on-caso-1.2 Allclean: limpa resultados (fluido OpenFOAM + solido CalculiX)
# e mantem config (system/* + 0/* + main.inp + all.inp + config.yml).
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

# Fluido (OpenFOAM)
( cd fluid && rm -rf [1-9]* 0.[0-9]* constant/polyMesh 0/polyMesh \
                     processor* postProcessing log.* precice-profiling )

# Solido (CalculiX) - apaga outputs do ccx mas preserva inp/config + meshes
( cd solid && rm -f main.frd main.dat main.cvg main.sta main.12d \
                    main.7p main.8x main.eig main.equ main.fbd \
                    main.pvd main.[0-9]*.vtu \
                    spooles.out log.* )
# (preserva: main.inp, all.msh, all.nam, config.yml)

# preCICE
rm -rf precice-Fluid-* precice-Solid-* precice-run precice-profiling
rm -f precice-postProcessingInfo.log core.* 2>/dev/null || true

echo "Allclean done. Mantidos: system/, 0/, main.inp, all.inp, config.yml, precice-config.xml"
