#!/bin/bash
# on-caso-1.2 -- FSI two-way ONSAS com lid POROSO (variante de on-caso-1
# que usa CalculiX 2.20 + adapter preCICE v2.20.1 no lado solido).
#
# Geometria:
#   - Fluido: identico a on-caso-1 (OpenFOAM solids4Foam pimpleFluid):
#       'sas'         z=[0, 30],   5760 cells, LCR water-like
#       'peri_porous' z=[30, 30.5], 384 cells, LCR + Darcy d=1e15 (fvOptions)
#   - Solido: CalculiX 7 zonas anatomicas (on, pia, dura, lc, sclera_peri,
#     sclera_ring, globo) com materiais hiperelasticos Neo-Hookean e
#     ~1056 elementos C3D8. Inclui contact_local (arteria oftalmica),
#     pressao estatica 1333 Pa nas faces internas da esclera (Truque de
#     Desacoplamento Seletivo), e engaste do globo. Sem Winkler no MVP
#     (CCX nao tem fundacao elastica nativa - iteracao futura).
#
# Acoplamento preCICE (IQN-ILS implicit two-way), 2 patches FSI:
#   fsi_pia (r=1.55), fsi_dura (r=2.35)
#
# Pipeline:
#   1. gen_on_caso_1_blockmesh.py     (fluido: blockMeshDicts)
#   2. gen_on_caso_1_2_ccx_inp.py     (solido: all.msh + all.nam, 7 zonas)
#   3. fluid: blockMesh + checkMesh
#   4. ccx_preCICE (solido) + solids4Foam (fluido) em paralelo via preCICE
#   5. ccx2paraview converte main.frd para main.pvd + main.*.vtu (ParaView)

set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

# ---- 1) Localizar brunaStuff/ (host vs container) -------------------------
BRUNA=""
if [[ -f "${ROOT}/../../brunaStuff/gen_on_caso_1_blockmesh.py" ]]; then
  BRUNA="$(cd "${ROOT}/../../brunaStuff" && pwd)"
elif [[ -f "/host/brunaStuff/gen_on_caso_1_blockmesh.py" ]]; then
  BRUNA="/host/brunaStuff"
fi

# ---- 2) Gerar malhas ------------------------------------------------------
# O solido do on-caso-1.2 e' a MESMA malha CIRCULAR do on-caso-1 (mesmo polyMesh),
# convertida para CalculiX. Se o polyMesh do solido do on-caso-1 nao existir e
# o OpenFOAM estiver disponivel, geramos via blockMesh+topoSet+createPatch.
ONC1_SOLID="${ROOT}/../on-caso-1/solid"
if [[ -n "$BRUNA" ]]; then
  echo "=== 1) Gerar blockMeshDict do fluido (lid poroso) ==="
  python3 "${BRUNA}/gen_on_caso_1_blockmesh.py"

  if [[ ! -f "${ONC1_SOLID}/constant/polyMesh/points" && -n "${WM_PROJECT_DIR:-}" ]]; then
    echo "=== 2a) Construir polyMesh redondo do solido (on-caso-1) ==="
    ( cd "$ONC1_SOLID" && rm -rf 0/polyMesh constant/polyMesh \
        && blockMesh > log.blockMesh 2>&1 \
        && topoSet -dict system/topoSetDict_contact > log.topoSet 2>&1 \
        && createPatch -overwrite -dict system/createPatchDict_contact > log.createPatch 2>&1 )
  fi

  echo "=== 2) Converter polyMesh redondo -> all.msh/all.nam/winkler.inp (CalculiX) ==="
  python3 "${BRUNA}/gen_on_caso_1_2_from_blockmesh.py"
elif [[ -f "${ROOT}/fluid/system/blockMeshDict" && -f "${ROOT}/solid/all.msh" && -f "${ROOT}/solid/all.nam" ]]; then
  echo "=== 1+2) SKIP gen (arquivos ja' presentes; brunaStuff nao montado) ==="
else
  echo "ERROR: cannot find generators and meshes not present" >&2
  exit 1
fi

if [[ -z "${WM_PROJECT_DIR:-}" ]]; then
  echo "SKIP solver: WM_PROJECT_DIR not set."
  exit 0
fi

# ---- 3) Fluid mesh --------------------------------------------------------
echo "=== 3) Fluid: blockMesh + checkMesh ==="
rm -rf precice-run 2>/dev/null || true
for f in precice-Fluid-* precice-Solid-*; do [ -e "$f" ] && rm -rf "$f"; done
( cd fluid && rm -rf 0/polyMesh constant/polyMesh log.* \
    && blockMesh 2>&1 | tee log.blockMesh \
    && checkMesh 2>&1 | tee log.checkMesh )

# ---- 4) Coupled solvers (CalculiX + OpenFOAM) -----------------------------
echo "=== 4) Coupled solvers (preCICE IQN-ILS implicit two-way) ==="
echo "    Fluido: solids4Foam (pimpleFluid)"
echo "    Solido: ccx_preCICE -i main -precice-participant Solid"
( cd fluid && solids4Foam > log.solids4Foam 2>&1 ) &
PF=$!
# CalculiX: ccx_preCICE le main.inp e config.yml na pasta atual
( cd solid && rm -f main.frd main.dat main.cvg main.sta main.12d \
                    main.7p main.8x main.dat 2>/dev/null \
    && ccx_preCICE -i main -precice-participant Solid > log.ccx 2>&1 ) &
PS=$!

RC_F=0; RC_S=0
wait $PF || RC_F=$?
wait $PS || RC_S=$?

if (( RC_F != 0 )); then
  echo "ERROR: fluid solids4Foam failed (rc=$RC_F)"; tail -40 fluid/log.solids4Foam; exit 1
fi
if (( RC_S != 0 )); then
  echo "ERROR: solid ccx_preCICE failed (rc=$RC_S)"; tail -40 solid/log.ccx; exit 1
fi
if grep -q "FOAM FATAL\|FOAM aborting" fluid/log.solids4Foam 2>/dev/null; then
  echo "ERROR: FATAL no log do fluido"
  grep -nE "FOAM FATAL|FOAM aborting" fluid/log.solids4Foam | head
  exit 1
fi
if grep -qE "ERROR|\*ERROR" solid/log.ccx 2>/dev/null; then
  echo "WARN: erros no log do CalculiX"
  grep -nE "ERROR|\*ERROR" solid/log.ccx | head
fi

# ---- 5) Converter .frd do CalculiX para .vtu/.pvd (ParaView) --------------
# ParaView nao abre .frd nativamente. ccx2paraview gera main.pvd (master
# multi-incremento) + main.{1..N}.vtu. Se a imagem ainda nao tem o pacote
# instalado (Dockerfile pre-rebuild), instala on-the-fly via pip --user.
echo "=== 5) Converter .frd -> .vtu (ParaView) ==="
if ! command -v ccx2paraview > /dev/null 2>&1; then
  if [[ ! -x "/home/ubuntu/.local/bin/ccx2paraview" ]]; then
    echo "  ccx2paraview nao encontrado, instalando localmente..."
    pip3 install --user --break-system-packages --no-cache-dir \
        ccx2paraview vtk > solid/log.pip 2>&1 \
      || echo "  WARN: falha pip install (ver solid/log.pip); pulando conversao"
  fi
  CCX2PV="/home/ubuntu/.local/bin/ccx2paraview"
else
  CCX2PV="$(command -v ccx2paraview)"
fi
if [[ -x "$CCX2PV" ]]; then
  ( cd solid && "$CCX2PV" main.frd vtu > log.ccx2paraview 2>&1 \
      && echo "  OK: solid/main.pvd + solid/main.{1..N}.vtu" \
      || echo "  WARN: conversao falhou (ver solid/log.ccx2paraview)" )
fi

echo ""
echo "=== Allrun finished. ==="
echo "    Fluido:   fluid/1/  (campos U, p, etc)"
echo "                paraview fluid/on-caso-1.2-fluid.foam"
echo "    Solido:   solid/main.pvd  (serie temporal CalculiX -> ParaView)"
echo "                paraview solid/main.pvd"
echo "    Logs:     solid/log.ccx, fluid/log.solids4Foam"
echo "    preCICE:  precice-Fluid-iterations.log, precice-Solid-iterations.log"
