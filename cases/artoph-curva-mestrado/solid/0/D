FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}

// artoph-curva-mestrado — deslocamento da artéria oftálmica curva
//
// Modelagem: artéria como SÓLIDO CHEIO (sem casca/lúmen oco). A geometria
// curva em "S/U" cruzando o nervo óptico vem do STL original do mestrado
// (constant/triSurface/artery.stl).
//
// Carregamento pulsátil:
//   constant/lumen_pressure.dat — gerado por gen_lumen_pressure_curva.py,
//   valores NEGATIVOS (-10700 a -16000 Pa). No solidTraction a tração é
//   sigma·n = -p·n; com p<0 a tração aponta na direção da normal externa
//   = expansão radial, simulando pressão sanguínea interna empurrando a
//   parede para fora.

dimensions      [ 0 1 0 0 0 0 0 ];

internalField   uniform (0 0 0);

boundaryField
{
    // Superfície lateral curva — recebe a pressão pulsátil expansiva.
    // Sintaxe pressureSeries (interpolationTable<scalar> nativa do solids4Foam):
    //   tabela em constant/lumen_pressure.dat tem o formato ( ( t p ) ... ).
    //   Valores são negativos (ver gen_lumen_pressure_curva.py): pressure < 0
    //   ≡ tração apontando para a normal externa = expansão.
    lumen
    {
        type            solidTraction;
        traction        uniform ( 0 0 0 );
        pressureSeries
        {
            "fileName|file"     "$FOAM_CASE/constant/lumen_pressure.dat";
            outOfBounds         clamp;
        }
        value           uniform ( 0 0 0 );
    }

    // Extremidade posterior (z ≈ -30 mm) — ancorada na entrada da órbita
    artoph_end_back
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
    }

    // Extremidade anterior (z ≈ 0 mm) — ancorada na adventícia próxima ao globo
    artoph_end_front
    {
        type        fixedDisplacement;
        value       uniform ( 0 0 0 );
    }
}
