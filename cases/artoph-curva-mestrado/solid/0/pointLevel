FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       pointScalarField;
    location    "0";
    object      pointLevel;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   nonuniform List<scalar> 8(1 2 2 2 2 2 2 2);

boundaryField
{
    lumen_inner
    {
        type            calculated;
    }
    lumen_outer
    {
        type            calculated;
    }
}


