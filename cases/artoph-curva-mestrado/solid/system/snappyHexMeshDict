FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

// artoph-curva-mestrado — malha do sólido elástico da artéria oftálmica curva
//
// Modelagem (v1): artéria como sólido cheio (sem casca/lúmen oco). A pressão
// pulsátil é aplicada como tração radial expansiva na superfície lateral
// (ver 0/D — patch lumen). Aproximação de primeira ordem que preserva a
// geometria curva (mecanismo dominante para tortuosidade do NO) e mantém a
// malha robusta. Versão hollow-wall (com casca de 0.2 mm) será uma evolução
// futura, exigindo extrudeMesh ou snappy multi-region mais elaborado.
//
// snappy preserva apenas o sólido da artéria; o background é descartado.

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    artery.stl
    {
        type    triSurfaceMesh;
        name    artery_surface;
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      6000000;
    minRefinementCells  10;
    nCellsBetweenLevels 2;

    features
    (
        { file "artery.eMesh"; level 3; }
    );

    refinementSurfaces
    {
        artery_surface
        {
            // level (2 3): cell size próximo à superfície ~62 µm (background
            // 0.5 mm / 2^3). Suficiente pra resolver a curvatura sem gerar
            // cells degeneradas. Aumentar mais é contraproducente: as cells
            // ficam tão finas que o snap não consegue evitar volume<0 nas
            // curvas mais apertadas do "S".
            level   (2 3);
            patchInfo { type wall; }
        }
    }

    resolveFeatureAngle     45;

    refinementRegions { }

    // Ponto interno ao sólido da artéria (calculado por
    // brunaStuff/gen_artoph_curva_geometry.py).
    locationInMesh          (-8.917667e-3  1.127375e-3  -1.643559e-2);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    // Mais smoothing + mais iterações de relax pra eliminar gaps visuais
    // entre cells de tamanhos diferentes (level 2 ↔ level 3) ao longo da
    // superfície curva. O ParaView renderiza esses saltos de tamanho como
    // "buracos" mesmo quando topologicamente a malha está fechada.
    nSmoothPatch        10;
    tolerance           2.0;
    nSolveIter          200;
    nRelaxIter          15;
    nFeatureSnapIter    20;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    layers              { }
    expansionRatio      1.0;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
    nRelaxIter          3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    #include "meshQualityDict"
    relaxed
    {
        maxNonOrtho 75;
    }
    nSmoothScale        4;
    errorReduction      0.75;
}

writeFlags ( );

mergeTolerance 1e-6;
