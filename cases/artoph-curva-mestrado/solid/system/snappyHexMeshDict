FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

// artoph-curva-mestrado — malha do sólido elástico da artéria oftálmica curva
//
// Modelagem (v1): artéria como sólido cheio (sem casca/lúmen oco). A pressão
// pulsátil é aplicada como tração radial expansiva na superfície lateral
// (ver 0/D — patch lumen). Aproximação de primeira ordem que preserva a
// geometria curva (mecanismo dominante para tortuosidade do NO) e mantém a
// malha robusta. Versão hollow-wall (com casca de 0.2 mm) será uma evolução
// futura, exigindo extrudeMesh ou snappy multi-region mais elaborado.
//
// snappy preserva apenas o sólido da artéria; o background é descartado.

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    artery.stl
    {
        type    triSurfaceMesh;
        name    artery_surface;
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      6000000;
    minRefinementCells  10;
    nCellsBetweenLevels 2;

    features
    (
        { file "artery.eMesh"; level 4; }
    );

    refinementSurfaces
    {
        artery_surface
        {
            // Aumentado de (2 3) para (3 4): superfície curva mais densamente
            // resolvida elimina o aspecto "esburacado" no ParaView causado
            // por saltos abruptos de tamanho de célula. Cell size próxima à
            // superfície ~30 µm (background 0.5 mm / 2^4).
            level   (3 4);
            patchInfo { type wall; }
        }
    }

    resolveFeatureAngle     30;

    refinementRegions { }

    // Ponto interno ao sólido da artéria (calculado por
    // brunaStuff/gen_artoph_curva_geometry.py).
    locationInMesh          (-8.917667e-3  1.127375e-3  -1.643559e-2);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        5;
    tolerance           4.0;
    nSolveIter          100;
    nRelaxIter          8;
    nFeatureSnapIter    15;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    layers              { }
    expansionRatio      1.0;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
    nRelaxIter          3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    #include "meshQualityDict"
    relaxed
    {
        maxNonOrtho 75;
    }
    nSmoothScale        4;
    errorReduction      0.75;
}

writeFlags ( );

mergeTolerance 1e-6;
