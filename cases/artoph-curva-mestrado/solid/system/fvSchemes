FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

// Análise quasi-estática pulsátil: inércia negligenciável para tecido biológico
// sob pulsação cardíaca (~1 Hz). steadyState = cada passo é solução estática.
// 'backward' ou 'Newmark' adicionariam termos de inércia incorretos neste regime.
d2dt2Schemes
{
    default         steadyState;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         leastSquares;
    grad(D)         leastSquares;
    grad(DD)        leastSquares;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

snGradSchemes
{
    default         none;
    snGrad(D)       corrected;
    snGrad(DD)      corrected;
}

interpolationSchemes
{
    default         linear;
}
