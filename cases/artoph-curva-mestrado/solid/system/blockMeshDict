FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// artoph-curva-mestrado — background mesh para snappyHexMesh
//
// A geometria real da artéria oftálmica vem do STL
// (cases/artoph-curva-mestrado/solid/constant/triSurface/lumen_*.stl),
// que descreve a artéria curva em forma de "S/U" passando pelo nervo óptico.
//
// Bbox dos STLs em metros (gerado por brunaStuff/gen_artoph_curva_geometry.py
// COM translação +30 mm em z para alinhar com a convenção do on-mestrado:
// posterior z=0, anterior z=+30 mm):
//   x: [-0.0114,  +0.0031]    (extents 14.5 mm)
//   y: [-0.0050,  +0.0034]    (extents  8.4 mm)
//   z: [-0.0001,  +0.0306]    (extents 30.6 mm; antes era z<0)
//
// Background box com folga de ~1.5 mm em cada direção:
//   x: [-0.0130, +0.0050]  →  18 mm
//   y: [-0.0065, +0.0050]  →  11.5 mm
//   z: [-0.0015, +0.0315]  →  33 mm
//
// Cell size do background = 0.5 mm. snappyHexMesh aplica refinementSurfaces
// level (3 4) sobre as superfícies lumen_inner/lumen_outer, levando o cell size
// próximo da parede a 0.5/2^4 ≈ 31 µm. Espessura da parede = 200 µm → ~6
// células através da espessura, suficiente para análise estrutural.

scale   1;

vertices
(
    (-0.0130  -0.0065  -0.0015 )   //  0
    ( 0.0050  -0.0065  -0.0015 )   //  1
    ( 0.0050   0.0050  -0.0015 )   //  2
    (-0.0130   0.0050  -0.0015 )   //  3
    (-0.0130  -0.0065   0.0315 )   //  4
    ( 0.0050  -0.0065   0.0315 )   //  5
    ( 0.0050   0.0050   0.0315 )   //  6
    (-0.0130   0.0050   0.0315 )   //  7
);

blocks
(
    // 36 x 23 x 65 = 53820 cells (~0.5 mm cells in background)
    hex (0 1 2 3 4 5 6 7)  (36 23 65)  simpleGrading (1 1 1)
);

edges ();

boundary
(
    // External walls of the background box — these get re-named/discarded by
    // snappyHexMesh, but solids4Foam still needs a boundary record. We give
    // them temporary patch names that will be deleted when snappy carves out
    // the artery wall region. The patches the solver will actually see come
    // from the STL solid names (lumen_inner, lumen_outer) plus the slicing
    // patches we create in snappyHexMeshDict for z=z_min and z=z_max.
    bg_xmin { type patch; faces ( (0 4 7 3) ); }
    bg_xmax { type patch; faces ( (1 2 6 5) ); }
    bg_ymin { type patch; faces ( (0 1 5 4) ); }
    bg_ymax { type patch; faces ( (3 7 6 2) ); }
    bg_zmin { type patch; faces ( (0 3 2 1) ); }
    bg_zmax { type patch; faces ( (4 5 6 7) ); }
);
