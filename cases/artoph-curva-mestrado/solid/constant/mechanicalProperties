FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}

// artoph-curva-mestrado — material da parede arterial (geometria curva)
//
// Material: elástico linear isótropo (pequenas deformações sob pressão fisiológica)
//   Ref: Holzapfel (2000); Stålhand (2009)
//
//   E  = 1.0 MPa  — módulo de Young (literatura: 0.5–2 MPa para pequenas artérias)
//   nu = 0.30     — diminuído de 0.45 para evitar volume locking numérico na
//                    formulação displacement-only com malha não-estruturada.
//                    Para reincorporar quasi-incompressibilidade fisiológica
//                    (ν → 0.49), habilitar solvePressureEqn (formulação u-p).
//   rho = 1050 kg/m³

planeStress     no;

mechanical
(
    arteria
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1050;
        E       E   [ 1 -1 -2 0 0 0 0 ] 1e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.30;
    }
);
