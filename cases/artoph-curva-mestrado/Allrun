#!/bin/bash
# artoph-curva-mestrado — pipeline completo da artéria oftálmica curva.
#
# Geometria real (forma de S/U cruzando o nervo óptico) vem dos STLs em
# solid/constant/triSurface/, gerados por brunaStuff/gen_artoph_curva_geometry.py
# a partir do arquivo original da dissertação:
#   ~/Documents/Doutorado/Backup/Geometria Mestrado.stl
#
# Pipeline:
#   1. blockMesh             → caixa background uniforme (~0.5 mm cells)
#   2. surfaceFeatureExtract → arestas vivas dos STLs (tampas em z=-30, z=0)
#   3. snappyHexMesh         → carve a parede arterial (espessura 0.2 mm)
#   4. topoSet               → identifica faces das duas tampas
#   5. createPatch           → cria patches lumen, outer_wall, artoph_end_back,
#                               artoph_end_front (mesmos nomes do caso reto)
#   6. solids4Foam           → análise quasi-estática pulsátil (2 ciclos cardíacos)
#
# Uso dentro do container Docker:
#   cd /simulation/artoph-curva-mestrado
#   chmod +x Allrun Allclean
#   ./Allrun

set -e

cd solid

echo "=== artoph-curva-mestrado: blockMesh (background uniforme) ==="
blockMesh | tee log.blockMesh

echo ""
echo "=== artoph-curva-mestrado: surfaceFeatureExtract ==="
# Tenta surfaceFeatures (v2306+) e cai pra surfaceFeatureExtract (legado).
if command -v surfaceFeatures >/dev/null 2>&1; then
    surfaceFeatures | tee log.surfaceFeatures
else
    surfaceFeatureExtract | tee log.surfaceFeatureExtract
fi

echo ""
echo "=== artoph-curva-mestrado: snappyHexMesh (carve parede arterial) ==="
snappyHexMesh -overwrite | tee log.snappyHexMesh

echo ""
echo "=== artoph-curva-mestrado: topoSet (identifica tampas) ==="
topoSet | tee log.topoSet

echo ""
echo "=== artoph-curva-mestrado: createPatch (lumen, outer_wall, end_back, end_front) ==="
createPatch -overwrite | tee log.createPatch

echo ""
echo "=== artoph-curva-mestrado: checkMesh ==="
checkMesh -allTopology -allGeometry | tee log.checkMesh

echo ""
echo "=== artoph-curva-mestrado: solids4Foam (pulsátil, 2 ciclos cardíacos) ==="
solids4Foam | tee log.solids4Foam

echo ""
echo "=== Concluído. Resultados salvos a cada 0.05 s em solid/<time>/ ==="
echo "    Para visualizar: paraFoam"
echo "    Campos: D (deslocamento), sigma_eq (von Mises)"
echo "    Pico sistólico  t=0.11s, 0.61s  →  expansão máxima"
echo "    Diástole        t=0.22s+        →  expansão baseline"
echo ""
echo "    Comparação com o caso reto (cases/artoph-mestrado):"
echo "      - Mesmas BCs, mesmo material, mesma pressão pulsátil"
echo "      - Só muda a geometria: cilindro reto vs curva real do mestrado"
