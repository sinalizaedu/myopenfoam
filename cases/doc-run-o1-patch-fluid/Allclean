#!/bin/bash
# Clean experiment outputs; keep seeded polyMesh unless FULL=1
set -euo pipefail
cd "$(dirname "$0")"
FULL="${FULL:-0}"
(
  cd fluid
  rm -rf log.* postProcessing dynamicCode codeStream processor* VTK
  # Remove experiment fractional times and non-baseline integer times
  find . -maxdepth 1 -type d -regex './[0-9]+\.[0-9]+' -exec rm -rf {} +
  for d in [0-9]*; do
    [ -e "$d" ] || continue
    base="$(basename "$d")"
    [[ "$base" == "0" ]] && continue
    # Keep seeded steady baseline dump (integer >= 50) unless FULL clean
    if [[ "$base" =~ ^[0-9]+$ ]] && [ "$base" -ge 50 ] && [ "$FULL" != "1" ]; then
      continue
    fi
    rm -rf "$d"
  done
  if [ "$FULL" = "1" ]; then
    rm -rf constant/polyMesh
    find . -maxdepth 1 -type d -name '[0-9]*' ! -name '0' -exec rm -rf {} +
  fi
  mkdir -p 0
  cp -f initial/U.experiment 0/U 2>/dev/null || cp -f initial/U.baseline 0/U
  cp -f initial/p.experiment 0/p 2>/dev/null || cp -f initial/p.baseline 0/p
  touch O1.foam case.foam
)
echo "=== doc-run-o1-patch-fluid: clean done (FULL=$FULL) ==="
