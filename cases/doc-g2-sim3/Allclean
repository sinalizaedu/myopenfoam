#!/bin/bash
# doc-g2-sim3 — Allclean

set -e
cd "$(dirname "$0")"

echo "=== doc-g2-sim3: cleaning fluid domain ==="

(
    cd fluid
    rm -rf log.* postProcessing dynamicCode codeStream
    for d in ./[0-9]*; do
        [ -e "$d" ] || continue
        base=$(basename "$d")
        case "$base" in
            0) ;;
            *) rm -rf "$d" ;;
        esac
    done
    rm -rf constant/polyMesh
    rm -f eye_g2_fluid_lamminsalo.msh
    mkdir -p 0
    cp -f initial/U.experiment.robin initial/U.experiment
    cp -f initial/U.baseline initial/U
    cp -f initial/p.baseline initial/p
    cp -f initial/U.baseline 0/U
    cp -f initial/p.baseline 0/p
    touch doc-g2-sim3-fluid.foam
    echo "  fluid cleaned"
)

echo "=== doc-g2-sim3: clean done ==="
