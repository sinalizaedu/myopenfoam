FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// G2-fluid Sim 3 — Model B ACP + volume-matched Robin wall
// Q_acp_quarter = 2.08325e-9 m³/s for t ∈ (15, 21] s
// During ACP: acp_tip out (−Q), wall in (+Q) — Windkessel surrogate
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    ac_inlet
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 1.25e-11;
        value           uniform (0 0 0);
    }
    outlet_tm { type zeroGradient; }

    acp_tip
    {
        type            flowRateInletVelocity;
        volumetricFlowRate table
        (
            (0    0)
            (15   0)
            (15.05 -2.08325e-9)
            (21   -2.08325e-9)
            (21.05 0)
            (1e6  0)
        );
        value           uniform (0 0 0);
    }

    wall
    {
        type            flowRateInletVelocity;
        volumetricFlowRate table
        (
            (0    0)
            (15   0)
            (15.05 2.08325e-9)
            (21   2.08325e-9)
            (21.05 0)
            (1e6  0)
        );
        value           uniform (0 0 0);
    }

    lens_wall { type noSlip; }
    iris_wall { type noSlip; }
    symmetry_0 { type symmetry; }
    symmetry_90 { type symmetry; }
    defaultFaces { type noSlip; }
}
