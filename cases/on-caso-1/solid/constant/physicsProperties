FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicsProperties;
}

// on-fsi-2 (FSI two-way: SAS = LCR fluido)
// Top-level physicsProperties: aqui o LADO SOLIDO declara `type solid` para
// que solids4Foam rode no modo solid-only (a coordenacao FSI eh feita por
// preCICE, NAO pelo fluidSolidInteraction interno do solids4foam).

type    solid;
