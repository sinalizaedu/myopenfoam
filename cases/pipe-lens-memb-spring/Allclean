#!/bin/bash
# pipe-lens-memb-spring — Allclean
# Removes all generated files: meshes, cellZones, time directories, logs, preCICE output.

set -e
cd "$(dirname "$0")"

echo "=== pipe-lens-memb-spring: cleaning ==="

for side in fluid solid; do
    (
        cd $side
        rm -rf constant/polyMesh
        rm -rf [1-9]* [0-9]*.[0-9]*
        rm -f  log.*
    )
done

# preCICE runtime files
rm -rf precice-run/ precice-profiling/ .precice-iterations* *.json

echo "  Done."
