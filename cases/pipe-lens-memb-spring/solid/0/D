FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}

// Displacement field — lens disc (pipe-lens-memb-spring).
//
// Support strategy: Winkler spring on rim (same k as pipe-lens-spring),
// wider zonula gap (R_lens=3mm vs 4.5mm) changes flow topology.
// FSI forces applied via preCICE solidForce on both axial faces.
// Symmetry planes constrain out-of-plane rigid-body modes.

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // ── preCICE FSI faces — fluid loads drive disc deformation ───────────
    interface_upstream
    {
        type            solidForce;
        forceField      solidForce;
        value           uniform (0 0 0);
    }

    interface_downstream
    {
        type            solidForce;
        forceField      solidForce;
        value           uniform (0 0 0);
    }

    // ── Rim (r=R_lens) — Winkler/Robin spring (zonula model).
    // Eliminates all rigid-body modes incl. axial (x) translation.
    // k = 1e4 Pa/m  →  equilibrium deflection ≈ 0.1 mm under 1 Pa driving ΔP.
    rim
    {
        type            robin;
        coeff0          uniform 1e4;
        coeff1          uniform 0;
        rhs             uniform (0 0 0);
        value           uniform (0 0 0);
    }

    // ── Inner face (r=Ri=1mm) — traction-free axis approximation ─────────
    axisApprox
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }

    // ── Symmetry planes ───────────────────────────────────────────────────
    symmetry_z
    {
        type            symmetryPlane;
        value           uniform (0 0 0);
    }

    symmetry_y
    {
        type            symmetryPlane;
        value           uniform (0 0 0);
    }
}
