FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// pipe-lens-memb-spring: solids4Foam — impermeable lens disc, quasi-static.
// Coupled to pimpleFoam via preCICE (serial-implicit, IQN-ILS).

application     solids4Foam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.01;
deltaT          0.0002;
writeControl    timeStep;
writeInterval   25;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    preCICE_Adapter
    {
        type preciceAdapterFunctionObject;
        libs ("libpreciceAdapterFunctionObject.so");
    }
}
