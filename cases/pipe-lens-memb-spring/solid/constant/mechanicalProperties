FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}

// Lens material: linear isotropic elastic (first prototype).
//
// E = 1e6 Pa (1 MPa) — soft intraocular lens / silicone-like at small strains.
// nu = 0.45           — nearly incompressible soft tissue.
// rho = 1100 kg/m³    — slightly denser than aqueous humour.
//
// These values drive the lens stiffness under IOP loading (400 Pa).
// Expected deflection ≈ O(0.1–1 mm) for a 4.5 mm disc — within linear range.
// Upgrade to hyperelastic (MooneyRivlin) if strains exceed ~10%.

planeStress     no;

mechanical
(
    lens
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 1e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }
);
