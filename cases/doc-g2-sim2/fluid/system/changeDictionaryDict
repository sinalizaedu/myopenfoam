FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// Use `symmetry` (not symmetryPlane): revolved CAD faces are not exact planes.
boundary
{
    symmetry_0 { type symmetry; }
    symmetry_90 { type symmetry; }
    wall  { type wall; }
    lens_wall { type wall; }
    iris_wall { type wall; }
    ac_inlet { type patch; }
    outlet_tm { type patch; }
    ivi_tip { type patch; }
    defaultFaces { type wall; }
}
