FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// G2-fluid 90° calotte cellZones.
// TM is a revolved annulus about +y — use cylinderAnnulusToCell (not a box).

actions
(
    {
        name    tm_zone;
        type    cellSet;
        action  new;
        source  cylinderAnnulusToCell;
        p1      (0 -0.00500 0);
        p2      (0 -0.00424 0);
        outerRadius 0.00720;
        innerRadius 0.00640;
    }
    {
        name    tm_zone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     tm_zone;
    }

    {
        name    vitreous_zone;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (-1.0e-4 -1.5e-3 -9.0e-3) (9.0e-3 7.5e-3 1.0e-4);
    }
    {
        name    vitreous_zone;
        type    cellSet;
        action  delete;
        source  cellToCell;
        set     tm_zone;
    }
    {
        name    vitreous_zone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     vitreous_zone;
    }
);
