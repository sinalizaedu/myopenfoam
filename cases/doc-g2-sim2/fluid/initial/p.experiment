FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// Experiment pressure BCs (rigid wall / noSlip companion)
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 2.0099;
boundaryField
{
    ac_inlet { type zeroGradient; }
    outlet_tm { type fixedValue; value uniform 1.3399; }
    ivi_tip { type zeroGradient; }
    wall { type zeroGradient; }
    lens_wall { type zeroGradient; }
    iris_wall { type zeroGradient; }
    symmetry_0 { type symmetry; }
    symmetry_90 { type symmetry; }
    defaultFaces { type zeroGradient; }
}
