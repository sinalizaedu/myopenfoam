FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// G2-fluid experiment — Model B tip IVI + volume-matched Robin wall
// Windkessel / volume-matched wall surrogate (Q_wall = -Q_ivi):
//   Q_wall(t) = -Q_ivi(t)  during IVI  → absorbs bolus (infinite-C limit)
// Pressure-coupled Un=C(p-p0)n was unstable with stiff G2 d_TM.
//
// Q_ivi_quarter = 2.08325e-9 m³/s for t ∈ (5, 11] s
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    ac_inlet
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 1.25e-11;
        value           uniform (0 0 0);
    }
    outlet_tm { type zeroGradient; }

    ivi_tip
    {
        type            flowRateInletVelocity;
        volumetricFlowRate table
        (
            (0    0)
            (5    0)
            (5.05 2.08325e-9)
            (11   2.08325e-9)
            (11.05 0)
            (1e6  0)
        );
        value           uniform (0 0 0);
    }

    // Robin / Windkessel: wall absorbs the sector bolus (outflow = -Q_ivi)
    wall
    {
        type            flowRateInletVelocity;
        volumetricFlowRate table
        (
            (0    0)
            (5    0)
            (5.05 -2.08325e-9)
            (11   -2.08325e-9)
            (11.05 0)
            (1e6  0)
        );
        value           uniform (0 0 0);
    }

    lens_wall { type noSlip; }
    iris_wall { type noSlip; }
    symmetry_0 { type symmetry; }
    symmetry_90 { type symmetry; }
    defaultFaces { type noSlip; }
}
