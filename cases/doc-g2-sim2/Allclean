#!/bin/bash
# doc-g2-sim2 — Allclean

set -e
cd "$(dirname "$0")"

echo "=== doc-g2-sim2: cleaning fluid domain ==="

(
    cd fluid
    rm -rf log.* postProcessing
    for d in ./[0-9]*; do
        [ -e "$d" ] || continue
        base=$(basename "$d")
        case "$base" in
            0) ;;
            *) rm -rf "$d" ;;
        esac
    done
    rm -rf constant/polyMesh
    rm -f eye_g2_fluid_lamminsalo.msh
    mkdir -p 0
    # Default working templates → baseline (experiment chosen at Allrun time)
    cp -f initial/U.experiment.robin initial/U.experiment
    cp -f initial/U.baseline initial/U
    cp -f initial/p.baseline initial/p
    cp -f initial/U.baseline 0/U
    cp -f initial/p.baseline 0/p
    touch doc-g2-sim2-fluid.foam
    echo "  fluid cleaned (templates → baseline; U.experiment → robin)"
)

echo "=== doc-g2-sim2: clean done ==="
