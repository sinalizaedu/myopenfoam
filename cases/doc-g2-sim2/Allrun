#!/bin/bash
# doc-g2-sim2 — G2 Sim 2: IVI by internal tip source + Robin wall compliance
# Geometry = G2-fluid (same as Sim 1). Coefficients frozen from doc-g2-sim1.
#
# Optional env:
#   MODE=baseline|experiment   (default baseline)
#   MESH_LEVEL=M1|M2|M3        (default M1 — recommended from G2 mesh study)
#   WALL_BC=robin|rigid        (experiment only; default robin = volume-matched)
#   D_TM=<value>
#   SKIP_SOLVE=1
#   REUSE_MESH=1               (required for MODE=experiment)
#   END_TIME=<s>               (override experiment endTime)
set -e
set -o pipefail
cd "$(dirname "$0")"
MODE="${MODE:-baseline}"
MESH_LEVEL="${MESH_LEVEL:-M1}"
WALL_BC="${WALL_BC:-robin}"
case "$MESH_LEVEL" in
    M1|M2|M3) ;;
    *) echo "ERROR: MESH_LEVEL must be M1, M2, or M3" >&2; exit 1 ;;
esac
case "$MODE" in
    baseline|experiment) ;;
    *) echo "ERROR: MODE must be baseline or experiment" >&2; exit 1 ;;
esac
case "$WALL_BC" in
    robin|rigid) ;;
    *) echo "ERROR: WALL_BC must be robin or rigid" >&2; exit 1 ;;
esac
D_TM="${D_TM:-}"
SKIP_SOLVE="${SKIP_SOLVE:-0}"
REUSE_MESH="${REUSE_MESH:-0}"
END_TIME="${END_TIME:-}"
if [ "$MODE" = "experiment" ] && [ "$REUSE_MESH" != "1" ]; then
    echo "ERROR: MODE=experiment requires REUSE_MESH=1 (init 0/ from calibrated baseline)" >&2
    exit 1
fi
MSH="geometry/eye_g2_fluid_lamminsalo_${MESH_LEVEL}.msh"
REPO_ROOT="$(cd ../.. && pwd)"

echo "=== doc-g2-sim2 MODE=${MODE} MESH_LEVEL=${MESH_LEVEL} WALL_BC=${WALL_BC} REUSE_MESH=${REUSE_MESH} ==="

if [ "$MODE" = "experiment" ]; then
    cp -f "fluid/initial/U.experiment.${WALL_BC}" fluid/initial/U.experiment
fi
cp -f "fluid/system/controlDict.${MODE}" fluid/system/controlDict
cp -f "fluid/system/fvSchemes.${MODE}" fluid/system/fvSchemes
cp -f "fluid/system/fvSolution.${MODE}" fluid/system/fvSolution
cp -f "fluid/initial/U.${MODE}" fluid/initial/U
cp -f "fluid/initial/p.${MODE}" fluid/initial/p

[ -n "$D_TM" ] && python3 scripts/set_d_tm.py "$D_TM"
if [ -n "$END_TIME" ]; then
    sed -i.bak -E "s/^(endTime[[:space:]]+).*/\\1${END_TIME};/" fluid/system/controlDict
    rm -f fluid/system/controlDict.bak
    echo "=== END_TIME override → ${END_TIME} ==="
fi

if [ "$REUSE_MESH" = "1" ]; then
    if [ ! -d fluid/constant/polyMesh ]; then
        echo "ERROR: REUSE_MESH=1 but fluid/constant/polyMesh missing — run without REUSE_MESH first" >&2
        exit 1
    fi
    if [ "$MODE" = "experiment" ]; then
        python3 scripts/init_experiment_from_baseline.py
        find fluid -maxdepth 1 -type d -regex '.*/[0-9]+\.[0-9]+' -exec rm -rf {} +
        rm -rf fluid/postProcessing/iop_probe fluid/postProcessing/flowRateIVI \
               fluid/postProcessing/flowRateWall fluid/postProcessing/flowRateTM \
               fluid/postProcessing/pressureACinlet 2>/dev/null || true
        rm -rf fluid/dynamicCode fluid/codeStream 2>/dev/null || true
        echo "=== WALL_BC=${WALL_BC} (U.experiment.${WALL_BC}) ==="
    else
        echo "WARNING: REUSE_MESH=1 with MODE=baseline remeshes" >&2
        REUSE_MESH=0
    fi
fi

if [ "$REUSE_MESH" != "1" ]; then
    if [ ! -f "$MSH" ]; then
        echo "ERROR: missing $MSH" >&2
        echo "  Generate sim2 IVI mesh (30G, IVI-only refine):" >&2
        echo "    .venv-geom/bin/python brunaStuff/gen_lamminsalo_g2.py \\" >&2
        echo "      --case doc-g2-sim2 --mesh --mesh-level ${MESH_LEVEL} --tip-refine ivi" >&2
        exit 1
    fi
    # Resolve symlink to a real file for gmshToFoam copy
    MSH_REAL="$(python3 -c "import os; print(os.path.realpath('$MSH'))")"
    cp -f "$MSH_REAL" geometry/eye_g2_fluid_lamminsalo.msh

    echo "=== gmshToFoam ==="
    rm -rf fluid/0 fluid/constant/polyMesh
    find fluid -maxdepth 1 -type d \( -name '[0-9]*' -o -name 'processor*' \) -exec rm -rf {} +
    mkdir -p fluid/0
    cp -f geometry/eye_g2_fluid_lamminsalo.msh fluid/eye_g2_fluid_lamminsalo.msh
    (cd fluid && gmshToFoam eye_g2_fluid_lamminsalo.msh 2>&1 | tee log.gmshToFoam)
    rm -f fluid/eye_g2_fluid_lamminsalo.msh

    echo "=== changeDictionary (patch types) ==="
    (cd fluid && changeDictionary 2>&1 | tee log.changeDictionary)

    echo "=== carve ac_inlet / outlet_tm from wall ==="
    if grep -q 'ac_inlet' fluid/constant/polyMesh/boundary 2>/dev/null; then
        (cd fluid && createPatch -overwrite -dict system/createPatchDict.demote 2>&1 | tee log.createPatch.demote)
        (cd fluid && changeDictionary 2>&1 | tee log.changeDictionary.demote)
    fi
    (cd fluid && topoSet -dict system/topoSetDict.splitPatches -constant 2>&1 | tee log.topoSet.splitPatches)
    (cd fluid && createPatch -overwrite -dict system/createPatchDict.splitPatches 2>&1 | tee log.createPatch.splitPatches)
    (cd fluid && changeDictionary 2>&1 | tee log.changeDictionary.postSplit)

    echo "=== IVI tip cavity (Model B — internal source) ==="
    (cd fluid && topoSet -dict system/topoSetDict.iviTip -constant 2>&1 | tee log.topoSet.iviTip)
    N_TIP=$(grep -E "cellSet ivi_tip_cells now size" fluid/log.topoSet.iviTip | tail -1 | awk '{print $NF}')
    echo "  ivi_tip_cells: ${N_TIP}"
    if [ -z "$N_TIP" ] || [ "$N_TIP" = "0" ]; then
        echo "ERROR: ivi_tip_cells is empty — adjust tip sphere in topoSetDict.iviTip" >&2
        exit 1
    fi
    (cd fluid && subsetMesh fluid_keep -patch ivi_tip -overwrite 2>&1 | tee log.subsetMesh.iviTip)
    (cd fluid && changeDictionary 2>&1 | tee log.changeDictionary.postTip)

    echo "=== topoSet zones (TM + vitreous) on tip-carved mesh ==="
    (cd fluid && topoSet -dict system/topoSetDict.g2 -constant 2>&1 | tee log.topoSet)

    echo "=== initial fields ==="
    cp fluid/initial/U fluid/0/U
    cp fluid/initial/p fluid/0/p
    rm -rf fluid/0/polyMesh

    echo "=== checkMesh ==="
    (cd fluid && checkMesh 2>&1 | tee log.checkMesh)
    if grep -q "FOAM FATAL" fluid/log.checkMesh; then
        echo "ERROR: checkMesh FOAM FATAL" >&2
        exit 1
    fi
    if grep -q "Failed" fluid/log.checkMesh; then
        echo "WARNING: checkMesh reported Failed (see log.checkMesh) — continuing" >&2
    fi
fi

echo "=== patch / zone counts ==="
python3 - <<'PY'
from pathlib import Path
import re
text = Path("fluid/constant/polyMesh/boundary").read_text()
wanted = (
    "ac_inlet", "outlet_tm", "ivi_tip", "wall", "lens_wall", "iris_wall",
    "symmetry_0", "symmetry_90",
)
for name in wanted:
    m = re.search(rf"\b{name}\b\s*\{{[^}}]*?nFaces\s+(\d+);", text, re.S)
    print(f"  {name}: {m.group(1) if m else 'MISSING'} faces")
cm = Path("fluid/log.checkMesh")
if cm.is_file():
    txt = cm.read_text()
    for z in ("tm_zone", "vitreous_zone"):
        m = re.search(rf"{z}\s+(\d+)", txt)
        print(f"  {z}: {m.group(1) if m else '?'} cells")
PY

if [ "$SKIP_SOLVE" = "1" ]; then
    echo "=== SKIP_SOLVE=1 done ==="
    grep -a "nCells:" fluid/log.checkMesh | head -3 || true
    exit 0
fi

if [ "$MODE" = "baseline" ]; then
    echo "=== simpleFoam (baseline verify) ==="
    (cd fluid && simpleFoam 2>&1 | tee log.simpleFoam)
    if grep -q "FOAM FATAL" fluid/log.simpleFoam; then
        echo "ERROR: simpleFoam failed" >&2
        exit 1
    fi
    python3 scripts/extract_step0_metrics.py || true
    python3 scripts/save_baseline_calibration.py || true
else
    echo "=== pimpleFoam (IVI tip + WALL_BC=${WALL_BC}) ==="
    (cd fluid && pimpleFoam 2>&1 | tee log.pimpleFoam)
    if grep -q "FOAM FATAL" fluid/log.pimpleFoam; then
        echo "ERROR: pimpleFoam failed" >&2
        exit 1
    fi
    echo "  post: IOP → fluid/postProcessing/iop_probe/"
    echo "        Q_ivi → fluid/postProcessing/flowRateIVI/"
    echo "        Q_wall (expansion) → fluid/postProcessing/flowRateWall/"
    python3 scripts/extract_metrics.py --wall "${WALL_BC}" || true
    python3 scripts/archive_experiment_results.py --wall "${WALL_BC}" || true
    python3 scripts/plot_iop_ivi.py --wall "${WALL_BC}" || true
fi

echo "=== doc-g2-sim2 done (MODE=${MODE}, ${MESH_LEVEL}) ==="
