#!/bin/bash
# eye-fsi-tc0 — Allrun
# ──────────────────────────────────────────────────────────────────────────
# 2D FSI: pimpleFoam (fluid) + solids4Foam (solid) coupled via preCICE.
#
# Solid domain contains all eye structures in one mesh (cell zones):
#   lens_zone   — deformable, FSI-coupled via preCICE
#   iris_zone   — rigid solid
#   sclera_zone — rigid solid (AC limbus rim)
#   cornea_zone — rigid solid (anterior dome)
# ──────────────────────────────────────────────────────────────────────────

set -e
set -o pipefail

cd "$(dirname "$0")"

echo "=== eye-fsi-tc0: meshing ==="

(cd fluid && blockMesh 2>&1 | tee log.blockMesh)
(cd fluid && changeDictionary 2>&1 | tee log.changeDictionary)
(cd fluid && topoSet -dict system/topoSetDict.internalNeedles 2>&1 | tee log.topoSet.internalNeedles)
(cd fluid && createBaffles -overwrite 2>&1 | tee log.createBaffles)
(cd fluid && changeDictionary -dict system/changeDictionaryDict.internalNeedles 2>&1 | tee log.changeDictionary.internalNeedles)
# changeDictionary rewrites 0/{U,p,pcorr,*Displacement} formatting and appends needle_int_* BCs.
echo "  Fluid mesh OK"

(cd solid && blockMesh 2>&1 | tee log.blockMesh)
echo "  Solid mesh OK (lens + iris + sclera + cornea)"

echo ""
echo "=== eye-fsi-tc0: running coupled FSI ==="
echo "  preCICE serial-explicit (Force fluid→solid), t∈[0,25]s, dt=0.01s — see precice-config.xml"
echo ""

# Launch solid in background (preCICE connector)
(cd solid && solids4Foam 2>&1 | tee log.solids4Foam) &
SOLID_PID=$!

# Wait for solid to initialise — poll until the process has been running for at
# least PRECICE_WAIT seconds or the solid has already exited (crash detection).
PRECICE_WAIT=10
echo "  Waiting ${PRECICE_WAIT}s for solid preCICE connector to initialise..."
for i in $(seq 1 $PRECICE_WAIT); do
    if ! kill -0 "$SOLID_PID" 2>/dev/null; then
        echo "ERROR: solid (solids4Foam) exited prematurely. Check solid/log.solids4Foam." >&2
        exit 1
    fi
    sleep 1
done

# Launch fluid in foreground (preCICE acceptor)
(cd fluid && pimpleFoam 2>&1 | tee log.pimpleFoam)

wait $SOLID_PID

echo ""
echo "=== eye-fsi-tc0: post-run checks ==="
echo ""

QTM=$(grep -a "flowRateTM" fluid/log.pimpleFoam 2>/dev/null | tail -1 | awk '{v=$NF; if (v+0==v && v!="") print v; else print "N/A"}' || echo "N/A")
echo "  Q_outlet_tm (last step) = $QTM"

echo ""
echo "=== eye-fsi-tc0: done ==="
echo "    ParaView files:"
echo "      fluid/eye-fsi-tc0-fluid.foam  — fluid flow field"
echo "      solid/eye-fsi-tc0-solid.foam  — all solids (lens FSI + iris + sclera + cornea)"
