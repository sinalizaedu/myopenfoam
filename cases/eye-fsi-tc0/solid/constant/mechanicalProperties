FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      mechanicalProperties;
}

// eye-fsi-tc0 — SOLID — 5 zonas materiais
//
//   iris        E=1 MPa   → D-shape visível (~1.7mm)
//   sclera_stub E=1 MPa   → deforma solidário com íris
//   lens        E=1 MPa   → abaulamento sob PC (~0.14mm)
//   sclera      E=1 GPa   → parede rígida, deformação pequena (~0.5mm)
//   cornea      E=100 MPa → abaulamento sob IOP (~0.8mm)

planeStress     no;

mechanical
(
    iris
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1000;
        E       E   [ 1 -1 -2 0 0 0 0 ] 1e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.30;
    }
    sclera_stub
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 1e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.30;
    }
    lens
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 1e6;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.30;
    }
    sclera
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1300;
        E       E   [ 1 -1 -2 0 0 0 0 ] 1e9;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }
    cornea
    {
        type    linearElastic;
        rho     rho [ 1 -3  0 0 0 0 0 ] 1100;
        E       E   [ 1 -1 -2 0 0 0 0 ] 1e8;
        nu      nu  [ 0  0  0 0 0 0 0 ] 0.45;
    }
);
