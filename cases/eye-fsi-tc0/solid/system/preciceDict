FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      preciceDict;
}

// preCICE adapter — SOLID participant (solids4Foam).
// ÍRIS ONLY: apenas patches da íris recebem Force do fluido.
// Lente, esclera e córnea foram removidas do domínio sólido.

participant   Solid;

preciceConfig "../precice-config.xml";

modules ( FSI );

interfaces
{
    Interface1
    {
        mesh          Solid-Mesh;
        patches       (
            iris_pupil iris_bottom iris_top
            iris_pupil_left iris_bottom_left iris_top_left
        );
        locations     faceCenters;
        readData      ( Force );
        writeData     ();
    }
}

FSI
{
    solverType              solid;
    namePointDisplacement   unused;
    nameCellDisplacement    unused;
    nameForce               solidForce;
}
