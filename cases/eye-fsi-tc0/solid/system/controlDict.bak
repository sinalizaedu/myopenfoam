FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// eye-fsi-tc0: solids4Foam — lens solid, coupled to pimpleFoam via preCICE.
// endTime and deltaT must match precice-config.xml max-time and time-window-size.

application     solids4Foam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         25;
deltaT          0.01;
writeControl    timeStep;
writeInterval   50;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    preCICE_Adapter
    {
        type preciceAdapterFunctionObject;
        libs ("libpreciceAdapterFunctionObject.so");
    }
}
