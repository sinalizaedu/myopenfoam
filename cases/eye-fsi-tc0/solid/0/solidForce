FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      solidForce;
}

// Force field written by the preCICE adapter from fluid pressure (iris patches only).

dimensions      [1 1 -2 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    iris_pupil            { type calculated; value uniform (0 0 0); }
    iris_bottom           { type calculated; value uniform (0 0 0); }
    iris_top              { type calculated; value uniform (0 0 0); }
    iris_base             { type zeroGradient; }
    iris_pupil_left       { type calculated; value uniform (0 0 0); }
    iris_bottom_left      { type calculated; value uniform (0 0 0); }
    iris_top_left         { type calculated; value uniform (0 0 0); }
    iris_base_left        { type zeroGradient; }
    front                 { type empty; }
    back                  { type empty; }
}
