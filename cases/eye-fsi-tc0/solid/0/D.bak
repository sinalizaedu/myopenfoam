FoamFile { version 2.0; format ascii; class volVectorField; object D; }
dimensions [0 1 0 0 0 0 0];
internalField uniform (0 0 0);
boundaryField {
    lens_bottom { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    lens_right  { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    lens_top    { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    lens_rim    { type fixedValue; value uniform (0 0 0); }
    iris_pupil  { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    iris_bottom { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    iris_top    { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    iris_base   { type fixedValue; value uniform (0 0 0); }
    sclera_side       { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    sclera_top_inner  { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    sclera_outer      { type fixedValue; value uniform (0 0 0); }
    sclera_tm_gap     { type solidTraction; traction uniform (0 0 0); pressure uniform 0; value uniform (0 0 0); }
    cornea_inner { type solidTraction; traction uniform (0 0 0); pressure uniform 2000; value uniform (0 0 0); }
    cornea_outer { type fixedValue; value uniform (0 0 0); }
    front { type empty; }
    back  { type empty; }
}
