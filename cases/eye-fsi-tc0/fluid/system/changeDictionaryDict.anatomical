FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
boundary
{
    front { type empty; }
    back  { type empty; }
    wall  { type wall; }
    ac_inlet { type patch; }
    ac_inlet_left { type patch; }
    outlet_tm { type patch; }
    outlet_tm_left { type patch; }
}
