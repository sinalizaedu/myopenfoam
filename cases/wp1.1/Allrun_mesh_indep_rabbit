#!/bin/bash
# Mesh independence — rabbit only (ne=6,12,24,48)
set -euo pipefail
cd "$(dirname "$0")"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-$(nproc 2>/dev/null || echo 4)}"
mkdir -p output_wp1.1/mesh_independence/rabbit
python3 scripts/mesh_independence.py rabbit | tee output_wp1.1/mesh_independence/rabbit/run.log
